<section class="section ejuno-services-hub">
  <div class="container">
    <header class="ejuno-services-hub__head">
      <div class="eyebrow">Services</div>
      <h1 class="ejuno-services-hub__title">{{ section.settings.heading }}</h1>
      {% if section.settings.subheading != blank %}
        <p class="ejuno-services-hub__subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>

    <div class="ejuno-services-hub__grid">
      {% for block in section.blocks %}
        {% liquid
          assign coll = block.settings.collection
          assign card_url = block.settings.url
          assign card_title = block.settings.title
          assign card_desc = block.settings.description
          assign card_image = block.settings.image
          assign card_fallback = block.settings.fallback_asset
          assign svc_h = block.settings.collection_handle

          if coll != blank
            assign card_url = coll.url
            assign svc_h = coll.handle
            if card_title == blank
              assign card_title = coll.title
            endif
            if card_desc == blank and coll.description != blank
              assign card_desc = coll.description | strip_html | truncate: 160
            endif
          endif

          if coll == blank and svc_h != blank
            for c in collections
              if c.handle == svc_h
                assign coll = c
                assign card_url = c.url
                if card_title == blank
                  assign card_title = c.title
                endif
                break
              endif
            endfor
          endif

          if card_url == blank and svc_h != blank
            # Trello 657: entertainment is 'entertainment-1' on prod but 'entertainment' on staging.
            if svc_h == 'entertainment-1' and collections['entertainment-1'].id == blank
              assign svc_h = 'entertainment'
            endif
            assign card_url = '/collections/' | append: svc_h
            # Trello 717: a category whose collection is not created yet (e.g. Transport) links to a search, not a 404.
            if collections[svc_h].id == blank
              assign card_url = routes.search_url | append: '?q=' | append: svc_h | append: '&type=product'
            endif
          endif

          # Keep hub cards in sync with market-hero banners (Trello 794 / category assets).
          # Trello 825: Gastronomy uses collection featured_image with srcset for sharpness.
          assign hero_match = ''
          assign use_gastro_srcset = false
          case svc_h
            when 'design-artistry'
              assign hero_match = 'ejuno-hero-1-7-d1440.jpg'
            when 'enhancements'
              assign hero_match = 'ejuno-hero-1-5-d1440.jpg'
            when 'beauty-fashion'
              assign hero_match = 'ejuno-hero-1-1-d1440.jpg'
            when 'transport'
              assign hero_match = 'ejuno-hero-1-3-d1440.jpg'
            when 'photo-film'
              assign hero_match = 'ejuno-cat-photo-film.jpg'
            when 'entertainment', 'entertainment-1'
              assign hero_match = 'ejuno-client-entertainment.jpg'
            when 'accommodation'
              assign hero_match = 'ejuno-hero-1-4-d1440.jpg'
          endcase
          if svc_h == 'gastronomy-bar' and coll != blank and coll.featured_image
            assign card_image = coll.featured_image
            assign card_fallback = blank
            assign use_gastro_srcset = true
          elsif hero_match != blank
            assign card_fallback = hero_match
            assign card_image = blank
          elsif card_image == blank and coll != blank and coll.featured_image
            assign card_image = coll.featured_image
          endif
        %}
        {% if card_url != blank and card_title != blank %}
          <a href="{{ card_url }}" class="ejuno-services-hub__card" {{ block.shopify_attributes }}>
            <div class="ejuno-services-hub__media">
              {% if card_image != blank %}
                {%- comment -%} Trello 825: Gastronomy uses higher-res srcset (1440, 2x) for sharp display. {%- endcomment -%}
                {%- if use_gastro_srcset -%}
                <img
                  src="{{ card_image | image_url: width: 1440 }}"
                  srcset="{{ card_image | image_url: width: 900 }} 900w, {{ card_image | image_url: width: 1440 }} 1440w, {{ card_image | image_url: width: 2880 }} 2880w"
                  sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 33vw"
                  alt="{{ card_title | escape }}"
                  width="1440"
                  height="960"
                  loading="lazy"
                >
                {%- else -%}
                <img
                  src="{{ card_image | image_url: width: 900 }}"
                  alt="{{ card_title | escape }}"
                  width="900"
                  height="600"
                  loading="lazy"
                >
                {%- endif -%}
              {% else %}
                <img
                  src="{{ card_fallback | default: 'SVC-IMG-002.webp' | asset_url }}"
                  alt="{{ card_title | escape }}"
                  width="900"
                  height="600"
                  loading="lazy"
                >
              {% endif %}
            </div>
            <div class="ejuno-services-hub__body">
              <h2 class="ejuno-services-hub__card-title">{{ card_title }}</h2>
              {% if card_desc != blank %}
                <p class="ejuno-services-hub__card-desc">{{ card_desc }}</p>
              {% endif %}
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
.ejuno-services-hub {
  padding-top: 48px;
  padding-bottom: 64px;
}
.ejuno-services-hub__head {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 40px;
}
.ejuno-services-hub__title {
  font-family: var(--serif);
  font-size: clamp(36px, 4vw, 48px);
  font-weight: 400;
  color: var(--ink);
  margin: 0 0 12px;
  position: relative;
  display: inline-block;
  line-height: 1.1;
  letter-spacing: -0.02em;
}
.ejuno-services-hub__title::after {
  content: '';
  display: block;
  width: 72px;
  height: 3px;
  background: var(--berry);
  margin: 14px auto 0;
  border-radius: 2px;
}
.ejuno-services-hub__subtitle {
  margin: 18px 0 0;
  font-family: var(--sans);
  color: var(--muted);
  font-size: 16px;
  line-height: 1.5;
  font-weight: 400;
}
.ejuno-services-hub__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 28px;
}
.ejuno-services-hub__card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: var(--shadow);
  border: 1px solid rgba(222, 213, 202, 0.65);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  color: inherit;
  text-decoration: none;
}
.ejuno-services-hub__card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow2);
}
.ejuno-services-hub__media img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  display: block;
}
.ejuno-services-hub__body {
  padding: 22px 22px 26px;
  text-align: center;
}
.ejuno-services-hub__card-title {
  font-family: var(--serif);
  font-size: 22px;
  font-weight: 400;
  color: var(--ink);
  margin: 0 0 10px;
  line-height: 1.25;
}
.ejuno-services-hub__card-desc {
  margin: 0;
  font-family: var(--sans);
  font-size: 14px;
  line-height: 1.55;
  font-weight: 400;
  color: var(--muted);
}
@media (max-width: 1100px) {
  .ejuno-services-hub__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 640px) {
  .ejuno-services-hub__grid {
    grid-template-columns: 1fr;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Services categories",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wedding Services"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Planners, photographers, florists, chefs and musicians who know Italy."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Service category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "collection_handle",
          "label": "Collection handle (if collection not set)",
          "info": "Example: gastronomy-bar"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link override"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Fallback theme asset",
          "default": "SVC-IMG-002.webp"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "collection_handle": "gastronomy-bar",
            "title": "Gastronomy & Bar",
            "description": "Catering, mixology, bar services, and gourmet experiences for your event.",
            "fallback_asset": "SVC-IMG-003.webp"
          }
        },
        {
          "type": "category",
          "settings": {
            "collection_handle": "design-artistry",
            "title": "Design & Artistry",
            "description": "Floral design, decor, staging, and creative wedding artistry.",
            "fallback_asset": "SVC-IMG-002.webp"
          }
        },
        {
          "type": "category",
          "settings": {
            "collection_handle": "photo-film",
            "title": "Photo & Film",
            "description": "Professional photography and videography to capture every moment.",
            "fallback_asset": "VEN-IMG-004.webp"
          }
        },
        {
          "type": "category",
          "settings": {
            "collection_handle": "entertainment-1",
            "title": "Entertainment",
            "description": "Live bands, DJs, performers, and interactive entertainment.",
            "fallback_asset": "VEN-IMG-006.webp"
          }
        },
        {
          "type": "category",
          "settings": {
            "collection_handle": "enhancements",
            "title": "Enhancements",
            "description": "Special effects, lighting, staging, and unique wedding enhancements.",
            "fallback_asset": "SVC-IMG-005.webp"
          }
        },
        {
          "type": "category",
          "settings": {
            "collection_handle": "beauty-fashion",
            "title": "Beauty & Fashion",
            "description": "Makeup, hairstyling, bridal styling, and fashion services.",
            "fallback_asset": "SVC-IMG-004.webp"
          }
        }
      ]
    }
  ]
}
{% endschema %}
