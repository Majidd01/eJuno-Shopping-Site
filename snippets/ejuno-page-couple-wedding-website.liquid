{% render 'ejuno-couple-search-hero', band_fallback: 'ejuno-client-find-a-wedding.jpg' %}
<section class="section tight">
  <div class="container">
    <div class="utility-panel utility-panel--open">
      <div class="section-head">
        <div class="copy">
          <div class="eyebrow">How it works</div>
          <h2 class="h2" style="font-size:42px">Find the right couple, then go straight there</h2>
        </div>
      </div>
      <ol class="ej-journey"><li class="ej-journey__item"><span class="ej-journey__dot" aria-hidden="true"></span><h3 class="ej-journey__title">Search</h3><p class="ej-journey__text">Enter the couple’s first or last name.</p></li><li class="ej-journey__item"><span class="ej-journey__dot" aria-hidden="true"></span><h3 class="ej-journey__title">Match</h3><p class="ej-journey__text">Review names and wedding dates to pick the right couple.</p></li><li class="ej-journey__item"><span class="ej-journey__dot" aria-hidden="true"></span><h3 class="ej-journey__title">Open</h3><p class="ej-journey__text">Open their website & registry when a public link is available.</p></li></ol>
    </div>
  </div>
</section>
