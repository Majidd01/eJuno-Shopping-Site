<div id="vendorForm" class="ejuno-vendor-form wedding_form_containernew flex_center">
  <div class="wedding_form_wrapper containernew flex_center">
    <div class="wedding_form_content">
      <p class="eyebrow ejuno-vendor-form__eyebrow">Partner application</p>
      <h2>
        Become a Partner - <span>eJuno</span>
      </h2>
      <p class="value-prop">
        Join wedding vendors who use eJuno to reach couples planning their wedding in Italy.
      </p>
      <p class="ejuno-vendor-form__note">
        Share a few details and our team will review your application.
        <span class="ejuno-vendor-form__lang">Please submit this form in English.</span>
      </p>
      <form>
        <div class="form-group">
          <div>
            <label for="first-name">First name <span class="required">*</span></label>
            <input type="text" id="first-name" placeholder="First name" required>
            <div class="field-error" id="first-name-error">First name is required</div>
          </div>
          <div>
            <label for="last-name">Last name <span class="required">*</span></label>
            <input type="text" id="last-name" placeholder="Last name" required>
            <div class="field-error" id="last-name-error">Last name is required</div>
          </div>
        </div>
        <div class="form-group">
          <div>
            <label for="email">Email address <span class="required">*</span></label>
            <input type="email" id="email" placeholder="Enter your email address" required>
            <div class="field-error" id="email-error">Please enter a valid email address</div>
          </div>
        </div>
        <div class="form-group phone-group">
          <div style="flex: 0 0 95px;">
