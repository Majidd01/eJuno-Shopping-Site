{% comment %}
  Production (ejuno.myshopify.com): ejuno.skylinxtech.co + Stripe live.
  Test store (test-skylinx.myshopify.com): ejuno-dev.skylinxtech.co + Stripe test.
{% endcomment %}
{% liquid
  assign ejuno_api_base = 'https://ejuno-dev.skylinxtech.co/api'
  assign ejuno_stripe_pk = 'pk_live_51M4hc4DtXWFAm5eDfF4SLa2nEn8pZzVZu8WUvkOWxLEkW28i4IbFnVG1sOGIHqHmy9rc6NMPMs2kDZyU2q13SmGj00NgSx793j'
  assign shop_host = shop.permanent_domain | downcase
  if shop_host == 'test-skylinx.myshopify.com' or shop_host contains 'test-skylinx'
    assign ejuno_api_base = 'https://ejuno-dev.skylinxtech.co/api'
    assign ejuno_stripe_pk = 'pk_test_51Qcm2nGDFESoFcQ1fmXVBE3phZ7O26qfTH2Il0PxLBnhyAaU8wGunq8bOtqNvZGPyXXJWlrjE8CIKL3F7uiklgnx00ZBuncLXL'
  endif
%}
<script>
  window.EJUNO_API_BASE = {{ ejuno_api_base | json }};
  window.EJUNO_STRIPE_PUBLISHABLE_KEY = {{ ejuno_stripe_pk | json }};
  window.EJUNO_API = window.EJUNO_API_BASE;
  window.ejunoApiOrigin = function () {
    return String(window.EJUNO_API_BASE || 'https://ejuno-dev.skylinxtech.co/api').replace(/\/api\/?$/, '');
  };
</script>
