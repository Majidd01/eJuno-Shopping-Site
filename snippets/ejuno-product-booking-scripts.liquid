<h2 class="olivers-guest-modal__title">Guest Details</h2>
<p class="bundle-guest-modal__lead">How many guests will be attending?</p>
<div class="olivers-guest-modal__dates bundle-guest-modal__rate">
<div class="bundle-guest-modal__rate-label">Price per person</div>
<div id="bundle-price-per-person" class="bundle-guest-modal__rate-value">${currencySymbol}${formatMoney(perPersonPrice)}</div>
</div>
<div class="olivers-guest-modal__field">
<label for="bundle-guest-count">Number of guests <span class="olivers-guest-modal__req">*</span></label>
${guestRangeHint ? `<p class="bundle-guest-modal__hint">${guestRangeHint}</p>` : ''}
<input type="number" id="bundle-guest-count" class="bundle-guest-modal__input" min="${minGuests}"${maxGuests != null ? ` max="${maxGuests}"` : ''} value="${initialGuestCount}" required />
<div id="bundle-guest-error" class="olivers-guest-modal__error" style="display:none;"></div>
</div>
<div class="olivers-guest-modal__total">
<div class="olivers-guest-modal__total-label">Total price</div>
<div id="bundle-total-price" class="olivers-guest-modal__total-value">${currencySymbol}${formatMoney(perPersonPrice * initialGuestCount)}</div>
<div id="bundle-price-breakdown" class="olivers-guest-modal__breakdown">${initialGuestCount} guest${initialGuestCount > 1 ? 's' : ''} × ${currencySymbol}${formatMoney(perPersonPrice)} per person</div>
</div>
<div class="bundle-guest-modal__actions">
<button type="button" id="cancelBundleGuest" class="bundle-guest-modal__cancel">Cancel</button>
<button type="button" id="confirmBundleGuest" class="bundle-guest-modal__confirm">Confirm &amp; Book</button>
</div>
</div>
`;
document.body.appendChild(popup);
const guestInput = document.getElementById('bundle-guest-count');
const errorEl = document.getElementById('bundle-guest-error');
const totalPriceEl = document.getElementById('bundle-total-price');
const breakdownEl = document.getElementById('bundle-price-breakdown');
const confirmBtn = document.getElementById('confirmBundleGuest');
function validateGuestCount(showError) {
const guestCount = parseInt(guestInput.value, 10);
if (!guestCount || guestCount < 1) {
if (showError) {
errorEl.textContent = 'Please enter a valid number of guests.';
errorEl.style.display = 'block';
}
return false;
}
if (selectedVariant && selectedVariant.minGuests != null && guestCount < minGuests) {
if (showError) {
errorEl.textContent = `Minimum guests required is ${minGuests}.`;
errorEl.style.display = 'block';
}
return false;
}
if (selectedVariant && selectedVariant.maxGuests != null && guestCount > maxGuests) {
if (showError) {
errorEl.textContent = `Maximum guests allowed is ${maxGuests}.`;
errorEl.style.display = 'block';
}
return false;
}
errorEl.textContent = '';
errorEl.style.display = 'none';
return true;
}
function updateBundleTotal() {
const count = parseInt(guestInput.value, 10) || 0;
const isValid = validateGuestCount(false);
if (confirmBtn) confirmBtn.disabled = !isValid;
if (!isValid) {
if (count > 0) validateGuestCount(true);
return;
}
const addOnsTotal = (typeof getSelectedAddOnsTotal === 'function') ? getSelectedAddOnsTotal(productDetails) : 0;
const total = (perPersonPrice * count) + addOnsTotal;
totalPriceEl.textContent = `${currencySymbol}${formatMoney(total)}`;
breakdownEl.textContent = addOnsTotal > 0
? `${count} guest${count > 1 ? 's' : ''} × ${currencySymbol}${formatMoney(perPersonPrice)} + add-ons ${currencySymbol}${formatMoney(addOnsTotal)}`
: `${count} guest${count > 1 ? 's' : ''} × ${currencySymbol}${formatMoney(perPersonPrice)} per person`;
}
guestInput.addEventListener('input', updateBundleTotal);
guestInput.addEventListener('change', updateBundleTotal);
updateBundleTotal();
document.getElementById('closeBundleGuestPopup').addEventListener('click', () => popup.remove());
document.getElementById('cancelBundleGuest').addEventListener('click', () => popup.remove());
popup.addEventListener('click', (e) => {
if (e.target === popup) popup.remove();
});
document.getElementById('confirmBundleGuest').addEventListener('click', () => {
const guestCount = parseInt(guestInput.value, 10);
if (!validateGuestCount(true)) {
return;
}
requestData.capacity = guestCount;
popup.remove();
document.querySelectorAll('.cdp-addr-overlay').forEach(function (el) { el.remove(); });
if (typeof showLoaderFull === 'function') showLoaderFull();
confirmBtn.disabled = true;
confirmBtn.textContent = 'Booking...';
confirmBtn.style.opacity = '0.7';
const authToken = localStorage.getItem("authToken") || "";
const customeris = localStorage.getItem("customerId") || "";
/* vendor-confirmation: bundle/service flow no longer reserves directly */
if (typeof hideLoaderFull === 'function') hideLoaderFull();
window.ejunoSendVendorConfirmation(requestData, { onDone: function(){ confirmBtn.disabled = false; confirmBtn.textContent = 'Confirm & Book'; confirmBtn.style.opacity = '1'; } });
return;
fetch(`${window.EJUNO_API}/reservations`, {
method: 'POST',
headers: {
'Content-Type': 'application/json',
'Authorization': authToken.startsWith('Bearer ') ? authToken : `Bearer ${authToken}`
},
body: JSON.stringify(requestData)
})
.then(response => {
if (!response.ok) {
return response.json().then(errorData => {
throw new Error(errorData.message || 'Booking failed. Please try again.');
});
}
return response.json();
})
.then(data => {
if (data && data.data) {
popup.remove();
showLoaderFull();
const bookingId = data.data._id;
const bookingData = data.data;
const orderId = data.data.orderRefId;
const weddingId = data.data.weddingRefId;
const Bdate = data.data.date;
const customerFirstName = localStorage.getItem("customerFirstName") || "";
const customerLastName = localStorage.getItem("customerLastName") || "";
const customerEmail = localStorage.getItem("customerEmail") || "";
const paymentPayload = {
reservationId: bookingId,
customerId: customeris,
payerEmail: customerEmail,
payerName: `${customerFirstName} ${customerLastName}`.trim(),
type: "reservation"
};
fetch(`${window.EJUNO_API}/payments/create-payment-intent`, {
method: 'POST',
headers: {
'Content-Type': 'application/json',
'Authorization': authToken.startsWith('Bearer ') ? authToken : `Bearer ${authToken}`
},
body: JSON.stringify(paymentPayload)
})
.then(response => response.json())
.then(paymentResponse => {
const clientSecret = paymentResponse.data.clientSecret;
initStripePaymentModal({
clientSecret: clientSecret,
prefill: {
firstName: customerFirstName || '',
lastName: customerLastName || '',
email: customerEmail || ''
},
submitLabel: 'Pay ' + getPaymentToPay(),
onSuccess: function() {
let venueName = 'Venue/Service';
try {
venueName = bookingData?.venueName || venueName;
if (venueName === 'Venue/Service' && typeof productDetails !== 'undefined' && productDetails) {
venueName = productDetails.title || productDetails.name || venueName;
}
} catch(e) {}
let paymentAmount = 'N/A';
try {
paymentAmount = (typeof getPaymentToPay === 'function' ? getPaymentToPay() : null) || 'N/A';
} catch(e) {}
const invoiceData = {
venueName: venueName,
amount: paymentAmount,
currency: getSelectedCurrency(),
bookingId: bookingId || 'N/A',
orderId: orderId,
weddingId: weddingId,
Bdate: Bdate,
paymentDate: new Date().toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' }),
checkInDate: bookingData?.checkInDate || bookingData?.date,
checkOutDate: bookingData?.checkOutDate || bookingData?.checkoutDate,
date: bookingData?.date
};
showPaymentSuccessPopup(invoiceData);
}
});
})
.catch(paymentError => {
showNotification("You need to log in before using our services.", 'error');
hideLoaderFull();
});
} else {
throw new Error('Invalid response from server.');
}
})
.catch(error => {
if (typeof hideLoaderFull === 'function') hideLoaderFull();
showNotification(error.message || 'Booking failed. Please try again.', 'error');
});
});
}
