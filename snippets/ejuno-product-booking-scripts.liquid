
<script>
/* eJuno vendor confirmation flow (2026-10-29): venue/service bookings now send the reservation payload to /api/vendor-confirmation instead of reserving directly. */
(function(){
var VC_SUCCESS = "We've received your request. We'll let you know by email, and you can also see the response to your request on your dashboard.";
var VC_ERROR = "Sorry, we couldn't send your request just now. Please try again shortly.";
function vcOrigin(){
  if (typeof window.ejunoApiOrigin === 'function') { try { var o = window.ejunoApiOrigin(); if (o) return String(o).replace(/\/$/, ''); } catch(e){} }
  return String(window.EJUNO_API || 'https://ejuno-dev.skylinxtech.co/api').replace(/\/$/, '').replace(/\/api$/, '');
}
function vcApiBase(){ return String(window.EJUNO_API || (vcOrigin() + '/api')).replace(/\/$/, ''); }
function vcShowMessage(text, type){
  var box = document.getElementById('ejuno-vendor-confirm-msg');
  if (!box) {
    box = document.createElement('div');
    box.id = 'ejuno-vendor-confirm-msg';
    box.setAttribute('role', 'status');
    box.setAttribute('aria-live', 'polite');
    box.style.cssText = 'margin:12px 0;padding:12px 14px;border-radius:8px;font-size:14px;line-height:1.45;';
    var anchor = Array.prototype.find.call(document.querySelectorAll('.ejuno-booking-submit'), function(el){ return el.offsetParent !== null; }) || document.querySelector('.ejuno-booking-submit') || document.getElementById('selected-date-div');
    if (anchor && anchor.parentNode) anchor.parentNode.insertBefore(box, anchor.nextSibling);
    else (document.querySelector('.calendar-container, #calendar, form[action*="cart"]') || document.body).appendChild(box);
  }
  box.textContent = text;
  box.className = 'ejuno-vendor-confirm-msg ejuno-vendor-confirm-msg--' + type;
  box.style.background = type === 'success' ? '#eef7ee' : '#fdecec';
  box.style.color = type === 'success' ? '#1e5b2a' : '#8a1f1f';
  box.style.border = '1px solid ' + (type === 'success' ? '#b9dcbf' : '#f3c2c2');
  box.style.display = 'block';
  try { box.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); } catch(e){}
}
function vcRequestedDates(req){
  var out = [];
  ['date','checkInDate','checkOutDate'].forEach(function(k){ if (req && req[k]) out.push(String(req[k]).slice(0,10)); });
  if (req && Array.isArray(req.dates)) req.dates.forEach(function(d){ out.push(String(d).slice(0,10)); });
  if (!out.length && Array.isArray(window.selectedDates)) window.selectedDates.forEach(function(d){ out.push(String(d).slice(0,10)); });
  return out.filter(function(v,i,a){ return v && a.indexOf(v) === i; });
}
function vcRefreshReservedDates(req){
  var pid = window.ejunoShopifyProductId || (req && req.shopifyProductId) || (typeof productId !== 'undefined' ? productId : null);
  if (!pid) { console.warn('[eJuno vendor-confirmation] no product id for reserved dates refetch'); return Promise.resolve(); }
  return fetch(vcApiBase() + '/products/shopify-product/' + encodeURIComponent(pid), { cache: 'no-store' })
    .then(function(r){ return r.json(); })
    .then(function(data){
      if (!data || !data.data) return;
      var pd = data.data;
      var variant = (pd.variants || []).find(function(v){ return String(v.variantId) === String(req && req.variantId); });
      var reserved = (variant && Array.isArray(variant.reservations)) ? variant.reservations.map(function(d){ return String(d).slice(0,10); }) : [];
      var pre = (pd.preReservations || []).map(function(d){ return String(d).slice(0,10); });
      var nowReserved = vcRequestedDates(req).filter(function(d){ return reserved.indexOf(d) !== -1 || pre.indexOf(d) !== -1; });
      console.info('[eJuno vendor-confirmation] reserved dates refetched; requested dates now reserved:', nowReserved);
      if (!nowReserved.length) return;
      try { if (Array.isArray(reservedDates)) { nowReserved.forEach(function(d){ if (reservedDates.indexOf(d) === -1) reservedDates.push(d); }); } } catch(e){}
      if (window.preReservations && typeof window.preReservations.add === 'function') nowReserved.forEach(function(d){ window.preReservations.add(d); });
      try { if (Array.isArray(selectedDates)) selectedDates.length = 0; } catch(e){}
      document.querySelectorAll('.day.selected').forEach(function(el){ el.classList.remove('selected'); });
      var ms = document.getElementById('month-select'), ys = document.getElementById('year-select');
      if (typeof generateCalendar === 'function' && ms && ys) generateCalendar(parseInt(ys.value,10), parseInt(ms.value,10));
      nowReserved.forEach(function(d){ document.querySelectorAll('.day[data-date="' + d + '"]').forEach(function(el){ el.classList.add('reserved','disabled'); el.style.pointerEvents='none'; }); });
    })
    .catch(function(err){ console.error('[eJuno vendor-confirmation] reserved dates refetch failed', err); });
}

/* 2026-10-30: map frontend booking data to the exact backend /vendor-confirmation payload shapes */
function vcCountryCode(c){
  c = String(c || '').trim(); if (!c) return '';
  if (/^[A-Za-z]{2}$/.test(c)) return c.toUpperCase();
  try { var dn = new Intl.DisplayNames(['en'], { type: 'region' }), L = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', lc = c.toLowerCase();
    for (var i=0;i<26;i++) for (var j=0;j<26;j++) { var code = L[i]+L[j], n = dn.of(code); if (n && n !== code && n.toLowerCase() === lc) return code; } } catch(e){}
  return c;
}
function vcAddr(a, withCode){
  if (!a || !a.address1) return null;
  var o = { address1: String(a.address1 || ''), city: String(a.city || ''), province: String(a.province || ''), zip: String(a.zip || ''), country: String(vcCountryCode(a.countryCode || a.country_code || a.country)) };
  if (withCode) o.countryCode = o.country;
  return o;
}
function vcNum(v){ var n = Number(v); return (v !== null && v !== '' && isFinite(n)) ? n : v; }
function vcIsService(){
  try { if (typeof vendorType !== 'undefined' && vendorType) return String(vendorType).toLowerCase() === 'service'; } catch(e){}
  var pd = window.productDetails || {}; return String(pd.vendorType || pd.type || '').toLowerCase() === 'service';
}
function vcAddons(list, fallbackDate){
  var slots = window.selectedAddOnTimeSlots || {}, pd = window.productDetails || {}, all = [];
  (pd.variants || []).forEach(function(v){ (v.addOns || []).forEach(function(a){ all.push(a); }); });
  return (list || []).map(function(it){
    var id = String(it.addonId || it._id || '');
    var def = all.find(function(a){ return String(a._id) === id; }) || {};
    var pt = String(it.priceType || def.priceType || 'fixed').toLowerCase();
    var dates = (Array.isArray(it.datesOfBooking) && it.datesOfBooking.length ? it.datesOfBooking : (fallbackDate ? [fallbackDate] : [])).map(function(d){ return String(d).slice(0,10); });
    var o = { addonId: id, priceType: pt, datesOfBooking: dates, numberOfDays: Number(it.numberOfDays) || dates.length || 1 };
    if (pt === 'bundle') o.noOfPersons = Number(it.noOfPersons || (window.selectedAddOnGuests || {})[id]) || 1;
    var ts = (it.timeSlot && it.timeSlot.startTime) ? it.timeSlot : slots[id];
    if (ts && ts.startTime) o.timeSlot = { startTime: ts.startTime, endTime: ts.endTime };
    return o;
  });
}
window.ejunoBuildVendorConfirmationPayload = function(r){
  r = r || {};
  var pd = window.productDetails || {};
  var addons = r.selectedAddOns || r.selectedAddons || [];
  var standalone = !!(r._standaloneAddon || r.kind === 'standalone_addon');
  var date = String(r.date || r.checkInDate || (addons[0] && addons[0].datesOfBooking && addons[0].datesOfBooking[0]) || (Array.isArray(window.selectedDates) && window.selectedDates[0]) || '').slice(0,10);
  var pid = r.shopifyProductId || pd.shopifyProductId || window.ejunoShopifyProductId;
  var vid = r.variantId || (typeof window.getVariantId === 'function' && window.getVariantId()) || (pd.variants && pd.variants[0] && (pd.variants[0].variantId || pd.variants[0].id));
  var out = { shopifyProductId: vcNum(pid), variantId: vcNum(vid), date: date };
  if (!standalone && vcIsService()) {
    if (r.capacity != null && r.capacity !== '') out.capacity = Number(r.capacity);
    var b = vcAddr(r.billingAddress, false), s = vcAddr(r.shippingAddress, false) || b;
    if (b) out.billingAddress = b; if (s) out.shippingAddress = s;
    return out;
  }
  out = Object.assign({ kind: standalone ? 'standalone_addon' : 'product' }, out);
  var bb = vcAddr(r.billingAddress, true); if (bb) out.billingAddress = bb;
  var sa = vcAddons(addons, date); if (sa.length) out.selectedAddOns = sa;
  return out;
};
window.ejunoSendVendorConfirmation = function(requestData, opts){
  opts = opts || {};
  var vcRaw = Object.assign({}, requestData || {});
  requestData = window.ejunoBuildVendorConfirmationPayload(requestData);
  window.ejunoLastVendorConfirmationPayload = requestData;
  var authToken = localStorage.getItem('authToken') || '';
  var url = vcApiBase() + '/vendor-confirmation';
  if (typeof showLoaderFull === 'function') showLoaderFull();
  return fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Authorization': authToken.startsWith('Bearer ') ? authToken : ('Bearer ' + authToken) },
    body: JSON.stringify(requestData)
  })
  .then(function(res){
    if (!res.ok) {
      return res.text().then(function(t){ var e = new Error('vendor-confirmation HTTP ' + res.status); e.status = res.status; e.body = t; throw e; });
    }
    return res.json().catch(function(){ return {}; });
  })
  .then(function(data){
    vcShowMessage(VC_SUCCESS, 'success');
    if (typeof window.ejunoShowReservationSummary === 'function') window.ejunoShowReservationSummary(data, vcRaw, requestData);
    return vcRefreshReservedDates(requestData).then(function(){ return data; });
  })
  .catch(function(err){
    console.error('[eJuno vendor-confirmation] request failed', err && err.status, err && err.body, err);
    vcShowMessage(VC_ERROR, 'error');
    return vcRefreshReservedDates(requestData);
  })
  .finally(function(){
    if (typeof hideLoaderFull === 'function') hideLoaderFull();
    if (typeof opts.onDone === 'function') { try { opts.onDone(); } catch(e){} }
  });
};
})();
</script>
