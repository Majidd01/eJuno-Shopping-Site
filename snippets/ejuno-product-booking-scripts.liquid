function findFlexibleDateRange() {
const nights = getFlexStayNights();
const sortedMonths = ejunoFlexMonths.slice().sort();
for (let m = 0; m < sortedMonths.length; m += 1) {
const parts = sortedMonths[m].split('-');
const year = parseInt(parts[0], 10);
const month = parseInt(parts[1], 10) - 1;
const daysInMonth = new Date(year, month + 1, 0).getDate();
for (let day = 1; day <= daysInMonth; day += 1) {
const checkIn = new Date(year, month, day);
checkIn.setHours(0, 0, 0, 0);
if (ejunoFlexStay === 'weekend') {
const dow = checkIn.getDay();
if (dow !== 5 && dow !== 6) continue;
}
const checkOut = new Date(checkIn);
checkOut.setDate(checkOut.getDate() + nights);
const inStr = toDateString(checkIn);
const outStr = toDateString(checkOut);
let blocked = false;
const cursor = new Date(checkIn);
while (cursor < checkOut) {
if (typeof isDateDisabled === 'function' && isDateDisabled(toDateString(cursor))) {
blocked = true;
break;
}
cursor.setDate(cursor.getDate() + 1);
}
if (blocked) continue;
return [inStr, outStr];
}
}
return null;
}

