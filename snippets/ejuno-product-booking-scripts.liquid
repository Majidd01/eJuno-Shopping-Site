<script>
  (function () {
    if (window.__ejunoAddrStack) return; window.__ejunoAddrStack = true;
    var hidden = [];
    function isOverlay(el) {
      if (!el || el.nodeType !== 1 || el.classList.contains('cdp-addr-overlay')) return false;
      var cs = getComputedStyle(el);
      if (cs.display === 'none' || cs.visibility === 'hidden') return false;
      if (cs.position !== 'fixed') return false;
      var r = el.getBoundingClientRect();
      return r.width >= window.innerWidth * 0.9 && r.height >= window.innerHeight * 0.9;
    }
    function hideUnder() {
      document.querySelectorAll('body *').forEach(function (el) {
        if (el.closest('.cdp-addr-overlay') || el.classList.contains('ejuno-addr-hidden-under')) return;
        if (!/modal|popup|overlay|calendar|booking|schedule|stripe/i.test((el.id || '') + ' ' + (typeof el.className === 'string' ? el.className : ''))) return;
        if (isOverlay(el)) { el.classList.add('ejuno-addr-hidden-under'); hidden.push(el); }
      });
      document.documentElement.classList.add('ejuno-addr-open');
    }
    function restore() {
      if (document.querySelector('.cdp-addr-overlay')) return;
      document.documentElement.classList.remove('ejuno-addr-open');
      hidden.forEach(function (el) { el.classList.remove('ejuno-addr-hidden-under'); });
      hidden = [];
    }
    new MutationObserver(function (muts) {
      var added = false, removed = false;
      muts.forEach(function (m) {
        m.addedNodes.forEach(function (n) { if (n.nodeType === 1 && n.classList.contains('cdp-addr-overlay')) added = true; });
        m.removedNodes.forEach(function (n) { if (n.nodeType === 1 && n.classList.contains('cdp-addr-overlay')) removed = true; });
      });
      if (added) hideUnder();
      if (removed) setTimeout(restore, 0);
    }).observe(document.body, { childList: true });
  })();
</script>
