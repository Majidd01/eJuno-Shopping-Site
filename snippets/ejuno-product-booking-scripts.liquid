const ms = document.getElementById('month-select');
const ys = document.getElementById('year-select');
if (!ms || !ys) return;
let month = parseInt(ms.value, 10);
let year = parseInt(ys.value, 10);
if (isNaN(month) || isNaN(year)) return;
month += delta;
