<section class="section tight">
  <div class="container">
    <div class="platform-reviews-slider" id="platform-reviews-slider" data-count="0">
      <button
        type="button"
        class="platform-reviews-nav platform-reviews-nav--prev"
        id="platform-reviews-prev"
        aria-label="Previous reviews"
        hidden
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div
        class="quotes platform-reviews-track"
        id="platform-reviews-list"
        aria-live="polite"
      >
        <div class="quote-card platform-reviews-status">
          <p style="color:var(--muted);margin:0">Loading reviews&hellip;</p>
        </div>
      </div>
      <button
        type="button"
        class="platform-reviews-nav platform-reviews-nav--next"
        id="platform-reviews-next"
        aria-label="Next reviews"
        hidden
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .platform-reviews-slider {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 0;
  }
  .platform-reviews-slider.has-nav {
    grid-template-columns: 42px minmax(0, 1fr) 42px;
    gap: 16px;
  }
  .platform-reviews-track.quotes {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -ms-overflow-style: none;
    scrollbar-width: none;
    padding: 4px 2px 10px;
    min-width: 0;
  }
  .platform-reviews-track.quotes::-webkit-scrollbar {
    display: none;
  }
  /* Default: up to 3 cards visible */
  .platform-reviews-track .quote-card {
    flex: 0 0 calc((100% - 36px) / 3);
    max-width: calc((100% - 36px) / 3);
    scroll-snap-align: start;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }
  /* 1 review: one wide card */
  .platform-reviews-slider[data-count="1"] .quote-card:not(.platform-reviews-status) {
    flex-basis: min(100%, 640px);
    max-width: min(100%, 640px);
  }
  /* 2 reviews: both fill the row */
  .platform-reviews-slider[data-count="2"] .quote-card:not(.platform-reviews-status) {
    flex-basis: calc((100% - 18px) / 2);
    max-width: calc((100% - 18px) / 2);
  }
  .platform-reviews-track .quote-card .stars {
    display: inline-flex;
    gap: 3px;
    color: #b48b45;
    letter-spacing: 0;
  }
  .platform-reviews-track .quote-card .stars svg {
    width: 14px;
    height: 14px;
    display: block;
  }
  .platform-reviews-track .quote-card .quote-author {
    margin: 16px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  .platform-reviews-track .quote-card .quote-author strong {
    color: var(--ink, #211d1a);
    font-weight: 600;
  }
  .platform-reviews-track .quote-card p.quote-body {
    margin: 10px 0 0;
    color: var(--muted);
    white-space: pre-line;
  }
  .platform-reviews-track .platform-reviews-status {
    flex: 1 1 100%;
    max-width: 100%;
  }
  .platform-reviews-nav {
    position: static;
    z-index: 2;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--line, rgba(33, 29, 26, 0.12));
    background: #fff;
    color: var(--ink, #211d1a);
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0;
    box-shadow: 0 8px 24px rgba(33, 29, 26, 0.1);
    transition: transform 0.2s ease, opacity 0.2s ease;
    flex-shrink: 0;
  }
  .platform-reviews-slider.has-nav .platform-reviews-nav {
    display: flex;
  }
  .platform-reviews-nav[hidden] {
    display: none !important;
  }
  .platform-reviews-nav:hover:not(:disabled) {
    transform: scale(1.05);
  }
  .platform-reviews-nav:disabled {
    opacity: 0.35;
    cursor: default;
    transform: none;
  }
  @media (max-width: 1100px) {
    .platform-reviews-track .quote-card {
      flex-basis: calc((100% - 18px) / 2);
      max-width: calc((100% - 18px) / 2);
    }
    .platform-reviews-slider[data-count="1"] .quote-card:not(.platform-reviews-status) {
      flex-basis: 100%;
      max-width: 100%;
    }
    .platform-reviews-slider[data-count="2"] .quote-card:not(.platform-reviews-status) {
      flex-basis: calc((100% - 18px) / 2);
      max-width: calc((100% - 18px) / 2);
    }
    .platform-reviews-slider.has-nav {
      gap: 12px;
    }
  }
  @media (max-width: 760px) {
    .platform-reviews-track .quote-card,
    .platform-reviews-slider[data-count="1"] .quote-card:not(.platform-reviews-status),
    .platform-reviews-slider[data-count="2"] .quote-card:not(.platform-reviews-status) {
      flex-basis: 100%;
      max-width: 100%;
    }
    .platform-reviews-slider.has-nav {
      grid-template-columns: 36px minmax(0, 1fr) 36px;
      gap: 8px;
    }
    .platform-reviews-nav {
      width: 36px;
      height: 36px;
    }
  }
</style>

<script>
(function () {
  var listEl = document.getElementById('platform-reviews-list');
  var sliderEl = document.getElementById('platform-reviews-slider');
  var prevBtn = document.getElementById('platform-reviews-prev');
  var nextBtn = document.getElementById('platform-reviews-next');
  var metricsEl = document.getElementById('platform-reviews-metrics');
  if (!listEl) return;

  var apiBase = String(window.EJUNO_API_BASE || window.EJUNO_API || 'https://ejuno-dev.skylinxtech.co/api').replace(/\/$/, '');
  var endpoint = apiBase + '/reviews/couple/all';
  var STAR_SVG = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 5.88 6.49.94-4.7 4.58 1.11 6.47L12 17.77l-5.8 3.05 1.11-6.47-4.7-4.58 6.49-.94L12 2.5z"/></svg>';
  var STAR_EMPTY_SVG = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 2.5l2.9 5.88 6.49.94-4.7 4.58 1.11 6.47L12 17.77l-5.8 3.05 1.11-6.47-4.7-4.58 6.49-.94L12 2.5z"/></svg>';
  var reviewCount = 0;
  var navBound = false;

  function escapeHtml(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function renderStars(rating) {
    var score = Math.max(0, Math.min(5, Math.round(Number(rating) || 0)));
    var html = '';
    for (var i = 0; i < 5; i++) html += i < score ? STAR_SVG : STAR_EMPTY_SVG;
    return html;
  }

  function firstSentence(text) {
    var cleaned = String(text || '').replace(/\s+/g, ' ').trim();
    if (!cleaned) return 'A trusted planning experience.';
    var match = cleaned.match(/^(.+?[.!?])(?:\s|$)/);
    var sentence = (match ? match[1] : cleaned).trim();
    if (sentence.length > 90) sentence = sentence.slice(0, 87).trim() + '\u2026';
    return sentence;
  }

  function bodyWithoutHeadline(comment, headline) {
    var cleaned = String(comment || '').trim();
    if (!cleaned) return '';
    var normalized = cleaned.replace(/\s+/g, ' ').trim();
    if (normalized.toLowerCase().indexOf(String(headline || '').toLowerCase()) === 0) {
      var rest = cleaned.slice(headline.length).replace(/^[\s.!?-\u2013\u2014]+/, '').trim();
      return rest || cleaned;
    }
    return cleaned;
  }

  function coupleName(couple) {
    var c = couple || {};
    return ((c.firstName || '') + ' ' + (c.lastName || '')).replace(/\s+/g, ' ').trim() || 'eJuno couple';
  }

  function weddingDetail(couple) {
    var w = (couple && couple.wedding) || {};
    var parts = [];
    if (w.location) parts.push(String(w.location).trim());
    if (w.weddingDate) {
      try {
        // Trello 675: fixed three-letter months ("Sep 2026", never "Sept").
        var d = new Date(w.weddingDate);
        if (!isNaN(d)) parts.push(['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getMonth()] + ' ' + d.getFullYear());
      } catch (e) {}
    }
    return parts.join(' \u00b7 ');
  }

  function filterReviews(reviews) {
    return (reviews || []).filter(function (r) {
      if (!r) return false;
      if (r.publishedPlatformRatings === false) return false;
      var pr = r.platformRatings || {};
      var overall = Number(pr.overallExperience || r.rating || 0);
      return overall >= 4;
    });
  }

  function updateMetrics(reviews) {
    // Trello 675: keep the stats hidden until there are at least 10 published reviews.
    if (metricsEl) metricsEl.classList.toggle('is-ready', reviews.length >= 10);
    if (!metricsEl || !reviews.length) return;

    var sum = 0;
    var recommend = 0;
    reviews.forEach(function (r) {
      var pr = r.platformRatings || {};
      var overall = Number(pr.overallExperience || r.rating || 0);
      sum += overall;
      if (Number(r.nps) >= 9 || overall >= 5) recommend += 1;
    });

    var avg = sum / reviews.length;
    var avgEl = metricsEl.querySelector('[data-metric="avg"]');
    var recEl = metricsEl.querySelector('[data-metric="recommend"]');
    var countEl = metricsEl.querySelector('[data-metric="count"]');

    if (avgEl) avgEl.textContent = avg.toFixed(1).replace(/\.0$/, '') + '/5';
    if (recEl) recEl.textContent = Math.round((recommend / reviews.length) * 100) + '%';
    if (countEl) countEl.textContent = String(reviews.length);
  }

  function renderReviewCard(review) {
    var couple = review.couple || {};
    var name = coupleName(couple);
    var detail = weddingDetail(couple);
    var comment = String(review.comment || '').trim();
    // Trello 675: only use a title when it is a short first sentence of a longer review (no repeat, no "…").
    var cleanedComment = comment.replace(/\s+/g, ' ');
    var firstMatch = cleanedComment.match(/^(.+?[.!?])\s+\S/);
    var headline = firstMatch && firstMatch[1].length <= 90 ? firstMatch[1].trim() : '';
    var body = headline ? bodyWithoutHeadline(comment, headline) : (comment || 'A trusted planning experience.');
    var rating = (review.platformRatings && review.platformRatings.overallExperience) || review.rating || 5;

    return (
      '<article class="quote-card">' +
        '<div class="stars" aria-label="' + escapeHtml(rating) + ' out of 5 stars">' + renderStars(rating) + '</div>' +
        (headline ? '<h3>' + escapeHtml(headline) + '</h3>' : '') +
        (body ? '<p class="quote-body">' + escapeHtml(body) + '</p>' : '') +
        '<p class="quote-author"><strong>' + escapeHtml(name) + '</strong>' +
          (detail ? ' \u00b7 ' + escapeHtml(detail) : '') +
        '</p>' +
      '</article>'
    );
  }

  function showStatus(message) {
    reviewCount = 0;
    listEl.innerHTML =
      '<div class="quote-card platform-reviews-status"><p style="color:var(--muted);margin:0">' +
      escapeHtml(message) +
      '</p></div>';
    if (sliderEl) sliderEl.setAttribute('data-count', '0');
    setNavVisible(false);
  }

  function visibleSlots() {
    if (window.matchMedia('(max-width: 760px)').matches) return 1;
    if (window.matchMedia('(max-width: 1100px)').matches) return 2;
    return 3;
  }

  function cardStep() {
    var card = listEl.querySelector('.quote-card:not(.platform-reviews-status)');
    if (!card) return listEl.clientWidth;
    var styles = window.getComputedStyle(listEl);
    var gap = parseFloat(styles.columnGap || styles.gap) || 18;
    return card.getBoundingClientRect().width + gap;
  }

  function updateNavState() {
    if (!prevBtn || !nextBtn) return;
    var maxScroll = Math.max(0, listEl.scrollWidth - listEl.clientWidth - 2);
    var canScroll = maxScroll > 4;
    if (!canScroll) {
      setNavVisible(false);
      return;
    }
    prevBtn.disabled = listEl.scrollLeft <= 2;
    nextBtn.disabled = listEl.scrollLeft >= maxScroll;
  }

  function setNavVisible(show) {
    if (!prevBtn || !nextBtn || !sliderEl) return;
    prevBtn.hidden = !show;
    nextBtn.hidden = !show;
    sliderEl.classList.toggle('has-nav', show);
  }

  function setupSlider(count) {
    if (!prevBtn || !nextBtn || !sliderEl) return;
    reviewCount = count;
    sliderEl.setAttribute('data-count', String(count));

    var needsNav = count > visibleSlots();
    setNavVisible(needsNav);

    if (!navBound) {
      prevBtn.addEventListener('click', function () {
        listEl.scrollBy({ left: -cardStep(), behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', function () {
        listEl.scrollBy({ left: cardStep(), behavior: 'smooth' });
      });
      listEl.addEventListener('scroll', updateNavState, { passive: true });
      window.addEventListener('resize', function () {
        var show = reviewCount > visibleSlots();
        setNavVisible(show);
        if (show) updateNavState();
      });
      navBound = true;
    }

    if (needsNav) {
      requestAnimationFrame(updateNavState);
    }
  }

  fetch(endpoint, { method: 'GET', credentials: 'omit' })
    .then(function (res) {
      if (!res.ok) throw new Error('Reviews request failed (' + res.status + ')');
      return res.json();
    })
    .then(function (payload) {
      var reviews = filterReviews((payload && payload.data && payload.data.reviews) || []);
      if (!reviews.length) {
        showStatus('No published couple reviews are available yet.');
        return;
      }
      updateMetrics(reviews);
      listEl.innerHTML = reviews.map(renderReviewCard).join('');
      setupSlider(reviews.length);
    })
    .catch(function (err) {
      console.error('Platform reviews fetch error:', err);
      showStatus('Unable to load reviews right now. Please try again later.');
    });
})();
</script>
