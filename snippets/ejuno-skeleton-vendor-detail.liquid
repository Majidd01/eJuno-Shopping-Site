<div class="ejuno-vendor-detail__skeleton" aria-hidden="true">
  <div class="ejuno-vendor-detail__skeleton-gallery">
    <span class="ejuno-skeleton-block"></span>
    <span class="ejuno-skeleton-block"></span>
    <span class="ejuno-skeleton-block"></span>
    <span class="ejuno-skeleton-block"></span>
  </div>
  <div class="ejuno-vendor-detail__skeleton-layout">
    <div class="ejuno-vendor-detail__skeleton-profile">
      <span class="ejuno-skeleton-block ejuno-skeleton-block--avatar"></span>
      <span class="ejuno-skeleton-line ejuno-skeleton-line--title"></span>
      <span class="ejuno-skeleton-line"></span>
      <span class="ejuno-skeleton-line"></span>
      <span class="ejuno-skeleton-line ejuno-skeleton-line--short"></span>
      <span class="ejuno-skeleton-block ejuno-skeleton-block--btn" style="margin-top:16px"></span>
    </div>
    <div>
      <span class="ejuno-skeleton-line ejuno-skeleton-line--title"></span>
      <div class="ejuno-skeleton-card-grid" style="margin-top:16px">
        {% for i in (1..4) %}
          <div class="ejuno-skeleton-result-card">
            <span class="ejuno-skeleton-block ejuno-skeleton-block--img" style="min-height:160px"></span>
            <div class="ejuno-skeleton-result-card__body">
              <span class="ejuno-skeleton-line"></span>
              <span class="ejuno-skeleton-line ejuno-skeleton-line--short"></span>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
