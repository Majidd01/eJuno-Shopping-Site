{% comment %}
  Inline header search panel (desktop + mobile toggles via ejuno-header-search.js).
{% endcomment %}
<div
  id="ejuno-header-search-panel"
  class="ejuno-header-search-panel"
  data-ejuno-header-search-panel
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Search"
>
  <div class="ejuno-header-search-panel__inner">
    <form
      class="ejuno-header-search-panel__form"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      data-ejuno-header-search-form
    >
      <input type="hidden" name="type" value="product">
      <label class="visually-hidden" for="ejuno-header-search-input">Search</label>
      <span class="ejuno-header-search-panel__field">
        <svg class="ejuno-header-search-panel__search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.75"/>
          <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        </svg>
        <input
          type="search"
          id="ejuno-header-search-input"
          name="q"
          class="ejuno-header-search-panel__input"
          placeholder="Search venues, services, and more"
          autocomplete="off"
          data-ejuno-header-search-input
        >
        <button
          type="button"
          class="ejuno-header-search-panel__close header-search-close"
          data-ejuno-header-search-close
          aria-label="Close search"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
          </svg>
        </button>
      </span>
      <button type="submit" class="visually-hidden" tabindex="-1" aria-hidden="true">Search</button>
    </form>

    <div class="ejuno-header-search-panel__extras">
      <div class="ejuno-header-search-panel__recent" data-ejuno-header-search-recent hidden>
        <p class="ejuno-header-search-panel__recent-title">Recent searches</p>
        <ul class="ejuno-header-search-panel__recent-list" data-ejuno-header-search-recent-list></ul>
      </div>

      <div class="ejuno-header-search-panel__suggest" data-ejuno-header-search-suggest hidden>
        <p class="ejuno-header-search-panel__suggest-title">Suggestions</p>
        <ul class="ejuno-header-search-panel__suggest-list" data-ejuno-header-search-suggest-list></ul>
      </div>
    </div>
  </div>
</div>
