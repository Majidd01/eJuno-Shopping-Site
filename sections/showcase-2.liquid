<section class="section"><div class="container"><div class="section-head"><div class="copy"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2 class="h2">{{ section.settings.heading }}</h2><p>Share your best work. Selected pieces are featured in eJuno Inspiration stories.</p></div></div><div class="portfolio-grid"><img src="{% if section.settings.image_1 != blank %}{{ section.settings.image_1 | image_url: width: 2000 }}{% else %}{{ section.settings.fallback_1 | asset_url }}{% endif %}" width="1672" height="941" loading="lazy"><div class="portfolio-stack"><img src="{% if section.settings.image_2 != blank %}{{ section.settings.image_2 | image_url: width: 2000 }}{% else %}{{ section.settings.fallback_2 | asset_url }}{% endif %}" width="1672" height="941" loading="lazy"><img src="{% if section.settings.image_3 != blank %}{{ section.settings.image_3 | image_url: width: 2000 }}{% else %}{{ section.settings.fallback_3 | asset_url }}{% endif %}" width="1672" height="941" loading="lazy"></div><div class="portfolio-stack"><img src="{% if section.settings.image_4 != blank %}{{ section.settings.image_4 | image_url: width: 2000 }}{% else %}{{ section.settings.fallback_4 | asset_url }}{% endif %}" width="1672" height="941" loading="lazy"><img src="{% if section.settings.image_5 != blank %}{{ section.settings.image_5 | image_url: width: 2000 }}{% else %}{{ section.settings.fallback_5 | asset_url }}{% endif %}" width="1672" height="941" loading="lazy"></div></div></div></section>

{% schema %}
{
  "name": "showcase 2",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1 (SHW-IMG-002.webp)"
    },
    {
      "type": "text",
      "id": "fallback_1",
      "label": "Fallback asset 1",
      "default": "SHW-IMG-002.webp"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2 (SVC-IMG-002.webp)"
    },
    {
      "type": "text",
      "id": "fallback_2",
      "label": "Fallback asset 2",
      "default": "SVC-IMG-002.webp"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3 (SVC-IMG-003.webp)"
    },
    {
      "type": "text",
      "id": "fallback_3",
      "label": "Fallback asset 3",
      "default": "SVC-IMG-003.webp"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4 (SVC-IMG-005.webp)"
    },
    {
      "type": "text",
      "id": "fallback_4",
      "label": "Fallback asset 4",
      "default": "SVC-IMG-005.webp"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5 (VMP-IMG-004.webp)"
    },
    {
      "type": "text",
      "id": "fallback_5",
      "label": "Fallback asset 5",
      "default": "VMP-IMG-004.webp"
    },
    {
      "type": "text",
      "id": "eyebrow",
