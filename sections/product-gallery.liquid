{% assign current_variant = product.selected_or_first_available_variant %}
<section class="pdp-top"><div class="container"><div class="pdp-titlebar"><div><div class="eyebrow">{% if product.type != blank %}{{ product.type }}{% else %}{{ section.settings.eyebrow }}{% endif %}</div><h1 class="h1">{{ product.title }}</h1></div>{% form 'product', product %}<input type="hidden" name="id" value="{{ current_variant.id }}"><button class="btn primary" type="submit" name="add"{% unless current_variant.available %} disabled{% endunless %}>{% if current_variant.available %}{{ section.settings.button_label }}{% else %}Unavailable{% endif %}</button>{% endform %}</div><div class="pdp-gallery">{% if product.media.size > 0 %}{% for media in product.media limit: 4 %}{% if forloop.first %}<img class="main" src="{{ media | image_url: width: 1600 }}" alt="{{ media.alt | default: product.title | escape }}" width="{{ media.preview_image.width }}" height="{{ media.preview_image.height }}" loading="eager">{% elsif forloop.index == 4 %}<img class="wide" src="{{ media | image_url: width: 1600 }}" alt="{{ media.alt | default: product.title | escape }}" width="{{ media.preview_image.width }}" height="{{ media.preview_image.height }}" loading="lazy">{% else %}<img src="{{ media | image_url: width: 1600 }}" alt="{{ media.alt | default: product.title | escape }}" width="{{ media.preview_image.width }}" height="{{ media.preview_image.height }}" loading="lazy">{% endif %}{% endfor %}{% else %}<img class="main" src="{{ 'PDP-IMG-001.webp' | asset_url }}" alt="{{ product.title | escape }}" width="1672" height="941" loading="eager"><img src="{{ 'PDP-IMG-002.webp' | asset_url }}" alt="" width="1672" height="941" loading="lazy"><img src="{{ 'PDP-IMG-003.webp' | asset_url }}" alt="" width="1672" height="941" loading="lazy"><img class="wide" src="{{ 'PDP-IMG-004.webp' | asset_url }}" alt="" width="1672" height="941" loading="lazy">{% endif %}</div></div></section>

{% schema %}
{
  "name": "Product gallery",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Fallback eyebrow",
      "default": "Venue"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Request Availability"
    }
  ],
  "presets": [
    {
      "name": "Product gallery"
    }
  ]
}
{% endschema %}
