<section class="utility-head"><div class="container"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1 class="h1">{{ section.settings.heading }}</h1><p class="lead">{{ section.settings.text }}</p><div class="search-box"><input placeholder="Search FAQs"><a class="btn secondary" data-action="Prototype search only.">Search</a></div></div></section>

{% schema %}
{
  "name": "Faqs hero",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQs"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clear Answers, Without the Ceremony"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The FAQ should solve problems quickly. It does not need to audition for a wedding magazine cover."
    }
  ],
  "presets": [
    {
      "name": "Faqs hero"
    }
  ]
}
{% endschema %}
