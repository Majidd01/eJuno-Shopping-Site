<section class="product-head"><div class="container"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1 class="h1">{{ section.settings.heading }}</h1><p class="lead">{{ section.settings.text }}</p></div></section>

{% schema %}
{
  "name": "Registry hero",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Registry"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Gift List Your Guests Will Love Using"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Add your favourite venues and wedding services to your registry and share it with guests so they can contribute to your special day."
    }
  ],
  "presets": [
    {
      "name": "Registry hero"
    }
  ]
}
{% endschema %}
