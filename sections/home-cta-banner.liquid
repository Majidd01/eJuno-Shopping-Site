<section class="section tight"><div class="container"><div class="full-banner" style="min-height:430px">
    {% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url: width: 2400 }}" width="1672" height="941" loading="lazy" style="height:430px" alt="{{ section.settings.heading | escape }}">{% else %}<img src="{{ 'HOME-BNR-002.webp' | asset_url }}" width="1672" height="941" loading="lazy" style="height:430px" alt="{{ section.settings.heading | escape }}">{% endif %}
    <div class="banner-copy"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2 class="h2">{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p><a href="{{ section.settings.button_url }}" class="btn primary">{{ section.settings.button_label }}</a></div>
    </div></div></section>

{% schema %}
{
  "name": "Home CTA banner",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A more meaningful way"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not sure where to start?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Tell us what you have in mind. We’ll point you toward the right place, the right people and the right next step."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get Personalised Guidance"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Home CTA banner"
    }
  ]
}
{% endschema %}
