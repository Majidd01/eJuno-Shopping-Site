
<section class="utility-head">
  <div class="container">
    <div class="eyebrow">{{ shop.name }}</div>
    <h1 class="h1">Coming soon</h1>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <div class="search-box">
        <input type="password" name="password" placeholder="Enter store password" aria-label="Password">
        <button class="btn primary" type="submit">Enter</button>
      </div>
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
