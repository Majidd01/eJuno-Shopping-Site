
<section class="utility-head"><div class="container"><h1 class="h1">Reset password</h1>
{% form 'reset_customer_password' %}{{ form.errors | default_errors }}
<div class="utility-panel" style="max-width:480px;margin:24px auto 0">
  <div class="field" style="margin-bottom:12px"><input type="password" name="customer[password]" placeholder="Password"></div>
  <div class="field" style="margin-bottom:12px"><input type="password" name="customer[password_confirmation]" placeholder="Confirm password"></div>
  <button class="btn primary" type="submit">Reset</button>
</div>{% endform %}</div></section>

{% schema %}
{
  "name": "Customer reset_password",
  "settings": []
}
{% endschema %}
