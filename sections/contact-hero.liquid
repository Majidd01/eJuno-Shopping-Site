<section class="utility-head"><div class="container"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1 class="h1">{{ section.settings.heading }}</h1><p class="lead">{{ section.settings.text }}</p></div></section>

{% schema %}
{
  "name": "Contact hero",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact Us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tell Us What You Need"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We are happy to help with your wedding plans, your listing or anything else. Email us at support@ejuno.io."
    }
  ],
  "presets": [
    {
      "name": "Contact hero"
    }
  ]
}
{% endschema %}
