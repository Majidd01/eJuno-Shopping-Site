<section class="b2b-hero">{% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url: width: 2400 }}" width="1672" height="941" loading="lazy">{% else %}<img src="{{ 'SHW-IMG-001.webp' | asset_url }}" width="1672" height="941" loading="lazy">{% endif %}<div class="b2b-copy"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1 class="h1" style="font-size:68px">{{ section.settings.heading }}</h1><p>Showcase the craft, style and experience behind your business in a way that helps the right couples understand why you are different.</p><a href="#showcaseWorkForm" class="btn primary">Submit Your Work</a></div></section>

{% schema %}
{
  "name": "Showcase hero",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "For wedding professionals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get Your Work Featured on eJuno"
    }
  ],
  "presets": [
    {
      "name": "Showcase hero"
    }
  ]
}
{% endschema %}
