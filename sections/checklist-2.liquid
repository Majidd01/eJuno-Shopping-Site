<section class="section tight"><div class="container check-shell"><aside class="timeline"><div class="active">12+ months</div><div>9–12 months</div><div>6–9 months</div><div>3–6 months</div><div>1–3 months</div><div>Final month</div><div>Wedding week</div></aside><div class="checklist"><div style="display:flex;justify-content:space-between;align-items:end;margin-bottom:8px"><div><div class="eyebrow">{{ section.settings.eyebrow }}</div><h3 class="h3" style="margin:6px 0">12+ months out</h3></div><a class="btn primary" href="https://ejuno-staging.web.app/couple-dashboard">Open Checklist</a></div><div class="task done"><span class="boxcheck"></span><div><strong>Define your wedding vision</strong><br><small>Completed</small></div></div><div class="task done"><span class="boxcheck"></span><div><strong>Set an initial budget</strong><br><small>Completed</small></div></div><div class="task"><span class="boxcheck"></span><div><strong>Shortlist venue regions</strong><br><small>In progress</small></div></div><div class="task"><span class="boxcheck"></span><div><strong>Begin venue enquiries</strong><br><small>Next up</small></div></div><div class="task"><span class="boxcheck"></span><div><strong>Start guest list</strong><br><small>Coming soon</small></div></div></div></div></section>

{%- comment -%} Trello 713: let couples pick their planning timeframe; the timeline and tasks rescale to it. {%- endcomment -%}
<div class="ej-cl-timeframe" id="ej-cl-tf-{{ section.id }}" hidden>
  <label for="ej-cl-tf-select-{{ section.id }}">Your wedding is in</label>
  <select id="ej-cl-tf-select-{{ section.id }}">
    <option value="6">6 months</option>
    <option value="9">9 months</option>
    <option value="12">12 months</option>
    <option value="18">18 months</option>
    <option value="24" selected>24 months</option>
  </select>
</div>
<style>
.ej-cl-timeframe{display:flex;align-items:center;gap:10px;margin:0 0 14px;font-size:14px}
.ej-cl-timeframe label{color:var(--muted,#6b625a)}
.ej-cl-timeframe select{padding:8px 34px 8px 12px;border:1px solid rgba(42,36,32,.18);border-radius:999px;background:#fff;font:inherit;cursor:pointer}
.check-shell .timeline div{cursor:pointer}
.check-shell .task small.ej-cl-when{color:var(--muted,#6b625a)}
</style>
<script>
(function(){
  var tf = document.getElementById('ej-cl-tf-{{ section.id }}');
  if (!tf) return;
  var root = tf.previousElementSibling;
  while (root && !(root.querySelector && root.querySelector('.check-shell'))) root = root.previousElementSibling;
  var shell = root && root.querySelector('.check-shell');
  if (!shell) return;
  var aside = shell.querySelector('.timeline'), list = shell.querySelector('.checklist');
  if (!aside || !list) return;
  var head = list.firstElementChild, title = head && head.querySelector('h3');
  /* stage boundaries in months before the wedding (from, to) */
  var STAGES = [
    {from: 24, to: 12, tasks: ['Define your wedding vision', 'Set an initial budget', 'Shortlist venue regions', 'Begin venue enquiries', 'Start guest list']},
    {from: 12, to: 9, tasks: ['Book your venue', 'Book your planner and photographer', 'Send save the dates', 'Arrange guest accommodation']},
    {from: 9, to: 6, tasks: ['Choose caterer and menu style', 'Book florist and music', 'Find your wedding attire', 'Plan guest travel']},
    {from: 6, to: 3, tasks: ['Send invitations', 'Menu and cake tasting', 'Prepare legal paperwork for Italy', 'Arrange transport']},
    {from: 3, to: 1, tasks: ['Confirm final guest numbers', 'Create the seating plan', 'Agree the day\u2019s timeline']},
    {from: 1, to: 0.25, label: 'Final month', tasks: ['Confirm every supplier', 'Settle final payments', 'Pack for Italy']},
    {from: 0.25, to: 0, label: 'Wedding week', tasks: ['Rehearsal and welcome drinks', 'Hand over to your planner', 'Enjoy the day']}
  ];
  function fmt(n){ return (Math.round(n * 10) / 10).toString(); }
  function build(total){
    var stages = [], catchUp = [];
    STAGES.forEach(function(s){
      if (s.to >= total) { catchUp = catchUp.concat(s.tasks); return; }
      var from = Math.min(s.from, total);
      var label = s.label || (fmt(from) + '\u2013' + fmt(s.to) + ' months');
      if (!s.label && s.from === 24) label = (total >= 12 ? fmt(total) : fmt(from)) + '\u201312 months';
      var tasks = s.tasks.slice();
      stages.push({label: label, tasks: tasks, catchUp: []});
    });
    if (catchUp.length && stages.length) stages[0].catchUp = catchUp;
    return stages;
  }
  function render(total, idx){
    var stages = build(total);
    idx = Math.min(idx || 0, stages.length - 1);
    aside.innerHTML = '';
    stages.forEach(function(s, i){
      var d = document.createElement('div'); d.textContent = s.label; d.tabIndex = 0; d.setAttribute('role', 'button');
      if (i === idx) d.className = 'active';
      d.addEventListener('click', function(){ render(total, i); });
      d.addEventListener('keydown', function(e){ if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); render(total, i); } });
      aside.appendChild(d);
    });
    var st = stages[idx];
    if (title) title.textContent = st.label + ' out';
    Array.prototype.slice.call(list.querySelectorAll('.task')).forEach(function(t){ t.remove(); });
    function add(name, note){
      var t = document.createElement('div'); t.className = 'task';
      t.innerHTML = '<span class="boxcheck"></span><div><strong></strong><br><small class="ej-cl-when"></small></div>';
      t.querySelector('strong').textContent = name; t.querySelector('small').textContent = note;
      list.appendChild(t);
    }
    st.catchUp.forEach(function(n){ add(n, 'Catch up now'); });
    st.tasks.forEach(function(n, i){ add(n, i === 0 && idx === 0 ? 'Start here' : 'To do'); });
    list.setAttribute('data-timeframe', total);
  }
  var sel = tf.querySelector('select');
  head.parentNode.insertBefore(tf, head.nextSibling); tf.hidden = false;
  sel.addEventListener('change', function(){ render(parseInt(sel.value, 10), 0); });
  render(24, 0);
})();
</script>

{% schema %}
{
  "name": "checklist 2",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Current focus"
    }
  ],
  "presets": [
    {
      "name": "checklist 2"
    }
  ]
}
{% endschema %}
