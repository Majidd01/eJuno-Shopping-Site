<section class="product-head"><div class="container"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1 class="h1">{{ section.settings.heading }}</h1><p class="lead">{{ section.settings.lead }}</p></div></section>

{% schema %}
{
  "name": "wedding-website 1",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Wedding website"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Wedding Website, Beautifully Done"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Share your story, the schedule and travel tips with guests, and collect RSVPs in one place."
    }
  ],
  "presets": [
    {
      "name": "wedding-website 1"
    }
  ]
}
{% endschema %}
