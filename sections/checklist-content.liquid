<section class="section tight"><div class="container check-shell"><aside class="timeline"><div class="active">12+ months</div><div>9–12 months</div><div>6–9 months</div><div>3–6 months</div><div>1–3 months</div><div>Final month</div><div>Wedding week</div></aside><div class="checklist"><div style="display:flex;justify-content:space-between;align-items:end;margin-bottom:8px"><div><div class="eyebrow">Current focus</div><h3 class="h3" style="margin:6px 0">12+ months out</h3></div><a class="btn primary" href="https://ejuno-staging.web.app/couple-dashboard">Open Checklist</a></div><div class="task done"><span class="boxcheck"></span><div><strong>Define your wedding vision</strong><br><small>Completed</small></div></div><div class="task done"><span class="boxcheck"></span><div><strong>Set an initial budget</strong><br><small>Completed</small></div></div><div class="task"><span class="boxcheck"></span><div><strong>Shortlist venue regions</strong><br><small>In progress</small></div></div><div class="task"><span class="boxcheck"></span><div><strong>Begin venue enquiries</strong><br><small>Next up</small></div></div><div class="task"><span class="boxcheck"></span><div><strong>Start guest list</strong><br><small>Coming soon</small></div></div></div></div></section>

{% schema %}
{
  "name": "Checklist content",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "editor_note",
      "label": "Editor note",
      "default": "Content below keeps the approved prototype structure."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Content item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Item"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Content item"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Add supporting content."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Checklist content"
    }
  ]
}
{% endschema %}
