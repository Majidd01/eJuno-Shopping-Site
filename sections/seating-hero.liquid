<section class="product-head"><div class="container"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1 class="h1">{{ section.settings.heading }}</h1><p class="lead">{{ section.settings.text }}</p></div></section>

{% schema %}
{
  "name": "Seating hero",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Seating plan"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Design the Room Around the People"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Seating is spatial. So the page is spatial too: a large working canvas, supporting guest panel and very little decorative nonsense."
    }
  ],
  "presets": [
    {
      "name": "Seating hero"
    }
  ]
}
{% endschema %}
