<section class="product-head"><div class="container"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1 class="h1">{{ section.settings.heading }}</h1><p class="lead">{{ section.settings.text }}</p></div></section>

{% schema %}
{
  "name": "Checklist hero",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Wedding checklist"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Know What Matters Next"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "See what to do and when, from the first ideas to the wedding week, so nothing important slips through."
    }
  ],
  "presets": [
    {
      "name": "Checklist hero"
    }
  ]
}
{% endschema %}
