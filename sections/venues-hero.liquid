<section class="market-hero">{% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url: width: 2400 }}" width="2172" height="724" loading="eager">{% else %}<img src="{{ 'VEN-IMG-001.webp' | asset_url }}" width="2172" height="724" loading="eager">{% endif %}<div class="market-hero-copy"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1 class="h1" style="font-size:64px">{{ section.settings.heading }}</h1></div></section>

{% schema %}
{
  "name": "Venues hero",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Explore collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Extraordinary Places for Your Wedding"
    }
  ],
  "presets": [
    {
      "name": "Venues hero"
    }
  ]
}
{% endschema %}
