{% liquid
  if section.settings.image != blank
    assign src = section.settings.image | image_url: width: 1600
    assign alt = section.settings.image.alt | default: section.settings.heading
    assign w = section.settings.image.width
    assign h = section.settings.image.height
  else
    assign src = 'ejuno-photo-18.jpg' | asset_url
    assign alt = section.settings.heading
    assign w = 960
    assign h = 1200
  endif
%}
<section class="section">
  <div class="container plan-editorial">
    <img src="{{ src }}" alt="{{ alt | escape }}" width="{{ w }}" height="{{ h }}" loading="lazy">
    <div>
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <p class="lead">{{ section.settings.lead }}</p>
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_url | default: '/collections/venues' }}" class="btn secondary">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Plan editorial",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Planning philosophy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Less noise. Better decisions."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Plan at your own pace and keep every decision in one calm, clear place. When you are ready, start with the venue."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore Venues"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Plan editorial"
    }
  ]
}
{% endschema %}
