<section class="section tight"><div class="container seating-shell"><div class="floor"><div class="eyebrow" style="margin-bottom:22px">Reception room</div><div class="rounds"><div class="round">T1</div><div class="round">T2</div><div class="round">T3</div><div class="round">T4</div><div class="round">T5</div><div class="round">T6</div><div class="round">T7</div><div class="round">T8</div><div class="round">T9</div><div class="round">T10</div><div class="round">T11</div><div class="round">T12</div></div></div><aside class="guest-panel"><div class="eyebrow">Unseated guests</div><h3 class="h3" style="margin:8px 0 14px">12 remaining</h3><div class="guest-chip">Maria Rossi</div><div class="guest-chip">Luca Bianchi</div><div class="guest-chip">Nadia +1</div><div class="guest-chip">James Cole</div><div class="guest-chip">Amira Khan</div><a class="btn primary" style="width:100%;margin-top:14px" href="https://ejuno-staging.web.app/couple-dashboard">Open Seating Plan</a></aside></div></section>

{% schema %}
{
  "name": "Seating content",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "editor_note",
      "label": "Editor note",
      "default": "Content below keeps the approved prototype structure."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Content item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Item"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Content item"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Add supporting content."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Seating content"
    }
  ]
}
{% endschema %}
