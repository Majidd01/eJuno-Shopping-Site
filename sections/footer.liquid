<footer class="footer">
  <div class="container footer-grid">
    <div>
      <div class="footer-logo"><picture class="footer-logo__img"><source srcset="{{ 'ejuno-logo-footer.svg' | asset_url }}" type="image/svg+xml"><img src="{{ 'ejuno-logo-footer.png' | asset_url }}" alt="eJuno" width="944" height="416" decoding="async"></picture></div>
      <p>{{ section.settings.blurb }}</p>
      {% liquid
        assign social_instagram = section.settings.social_instagram | default: 'https://www.instagram.com/ejuno_events/'
        assign social_facebook = section.settings.social_facebook | default: 'https://www.facebook.com/profile.php?id=61578777266068'
        assign social_pinterest = section.settings.social_pinterest | default: 'https://www.pinterest.com/ejuno_events/'
        assign social_tiktok = section.settings.social_tiktok | default: 'https://www.tiktok.com/@ejuno_events'
        assign social_youtube = section.settings.social_youtube | default: 'https://www.youtube.com/@ejuno_events'
        assign terms_url = section.settings.terms_url | default: '/pages/terms-of-service'
        assign copyright_year = 'now' | date: '%Y'
      %}
      <ul class="footer-social" aria-label="Social media">
        {% if social_instagram != blank %}
          <li>
            <a href="{{ social_instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.75"/><circle cx="12" cy="12" r="4.25" stroke="currentColor" stroke-width="1.75"/><circle cx="17.35" cy="6.65" r="1.1" fill="currentColor"/></svg>
            </a>
          </li>
        {% endif %}
        {% if social_facebook != blank %}
          <li>
            <a href="{{ social_facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14.5 8.5V7.1c0-.7.5-1.1 1.2-1.1H17V3.5h-2.1C12.4 3.5 11 5 11 7.3v1.2H9v2.6h2V20.5h3.5v-9.4h2.3l.4-2.6h-2.7z"/></svg>
            </a>
          </li>
        {% endif %}
        {% if social_pinterest != blank %}
          <li>
            <a href="{{ social_pinterest }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.3 9.3-.1-.8-.2-2 0-2.9.2-.8 1.4-5.9 1.4-5.9s-.3-.7-.3-1.7c0-1.6.9-2.8 2.1-2.8 1 0 1.5.7 1.5 1.6 0 1-.6 2.5-1 3.9-.3 1.2.6 2.1 1.7 2.1 2.1 0 3.5-2.7 3.5-5.9 0-2.4-1.6-4.2-4.5-4.2-3.3 0-5.3 2.4-5.3 5.1 0 .9.3 1.6.7 2.1.1.1.1.2.1.3l-.3 1c0 .2-.2.3-.4.2-1.6-.7-2.4-2.5-2.4-4.5 0-3.4 2.9-7.4 8.4-7.4 4.5 0 7.5 3.3 7.5 6.8 0 4.6-2.6 8.1-6.4 8.1-1.3 0-2.5-.7-2.9-1.5l-.8 3c-.3 1.1-1 2.4-1.5 3.2C9.5 21.8 10.7 22 12 22c5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>
            </a>
          </li>
        {% endif %}
        {% if social_tiktok != blank %}
          <li>
            <a href="{{ social_tiktok }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 4.2c.9 1 2.1 1.7 3.4 1.9V9c-1.2-.1-2.3-.5-3.3-1.2v6.1c0 3.3-2.7 6-6 6s-6-2.7-6-6 2.7-6 6-6c.3 0 .6 0 .9.1v3.1c-.3-.1-.6-.2-.9-.2-1.6 0-2.9 1.3-2.9 2.9s1.3 2.9 2.9 2.9 2.9-1.3 2.9-2.9V4.2h3z"/></svg>
            </a>
          </li>
        {% endif %}
        {% if social_youtube != blank %}
          <li>
            <a href="{{ social_youtube }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.7 2.7 0 0 0-1.9-1.9C18 4.8 12 4.8 12 4.8s-6 0-7.7.5A2.7 2.7 0 0 0 2.4 7.2 28.4 28.4 0 0 0 1.9 12a28.4 28.4 0 0 0 .5 4.8 2.7 2.7 0 0 0 1.9 1.9c1.7.5 7.7.5 7.7.5s6 0 7.7-.5a2.7 2.7 0 0 0 1.9-1.9c.3-1.6.5-3.2.5-4.8a28.4 28.4 0 0 0-.5-4.8zM10 15.2V8.8l5.2 3.2L10 15.2z"/></svg>
            </a>
          </li>
        {% endif %}
      </ul>
    </div>
    {%- comment -%} Review p15: columns collapse into Plan / Explore / Company / Legal on mobile. {%- endcomment -%}
    {%- assign ft_cols = 'plan,explore,company' | split: ',' -%}
    {%- for col in ft_cols -%}
      {%- assign col_type = col | append: '_link' -%}
      {%- assign col_heading_key = col | append: '_heading' -%}
      {%- assign col_count = 0 -%}
      {%- for link in section.blocks -%}{%- if link.type == col_type -%}{%- assign col_count = col_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if col_count > 0 -%}
        <details class="footer-col" data-footer-col open>
          <summary><h4>{{ section.settings[col_heading_key] }}</h4></summary>
          <div class="footer-col__links">
            {%- for link in section.blocks -%}
              {%- if link.type == col_type -%}
                <a href="{{ link.settings.url }}" {{ link.shopify_attributes }}>{{ link.settings.label }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </details>
      {%- endif -%}
    {%- endfor -%}
    <details class="footer-col footer-col--legal" data-footer-col>
      <summary><h4>{{ section.settings.legal_heading | default: 'Legal' }}</h4></summary>
      <div class="footer-col__links">
        <a href="{{ section.settings.privacy_url | default: '/pages/privacy-policy?view=privacy-policy' }}">Privacy Policy</a>
        <a href="{{ terms_url }}">{{ section.settings.terms_label | default: 'Terms & Conditions' }}</a>
      </div>
    </details>
  </div>

  <div class="footer-legal">
    <div class="container footer-legal__inner">
      <p class="footer-legal__copy">
        © {{ copyright_year }} e{{ section.settings.logo_text | default: 'Juno' }}
        <span class="footer-legal__dot" aria-hidden="true">•</span>
        {{ section.settings.copyright_text | default: 'All Rights Reserved' }}
      </p>
      <a class="footer-legal__brand" href="{{ routes.root_url }}" aria-label="eJuno home">
        <picture class="footer-legal__brand-img"><source srcset="{{ 'ejuno-logo-footer.svg' | asset_url }}" type="image/svg+xml"><img src="{{ 'ejuno-logo-footer.png' | asset_url }}" alt="" width="944" height="416" decoding="async"></picture>
      </a>
      <span class="footer-legal__links">
        <a class="footer-legal__terms" href="{{ section.settings.privacy_url | default: '/pages/privacy-policy?view=privacy-policy' }}">Privacy Policy</a>
        <span class="footer-legal__dot" aria-hidden="true">•</span>
        <a class="footer-legal__terms" href="{{ terms_url }}">
          {{ section.settings.terms_label | default: 'Terms & Conditions' }}
        </a>
      </span>
    </div>
  </div>
</footer>

{% stylesheet %}
.footer {
  padding-bottom: 0;
}
.footer-logo {
  font-family: var(--serif);
  font-size: 32px;
  letter-spacing: 0.02em;
  color: #fff;
  line-height: 1.1;
  margin-bottom: 4px;
}
.footer-logo__img img {
  display: block;
  height: 44px;
  width: auto;
  max-width: 100%;
}
.footer-legal__brand-img img {
  display: block;
  height: 24px;
  width: auto;
}
.footer-logo b {
  font-weight: 400;
  color: var(--berry);
}
.footer-social {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  list-style: none;
  margin: 18px 0 0;
  padding: 0;
}
.footer .footer-social a,
.footer-social a {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  margin: 0 !important;
  border-radius: 50%;
  border: 1px solid rgba(237, 230, 222, 0.22);
  color: #ede6de;
  background: rgba(255, 255, 255, 0.04);
  transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  line-height: 0;
}
.footer .footer-social a svg,
.footer-social a svg {
  display: block;
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  overflow: visible;
}
.footer-social a:hover {
  color: #fff;
  background: rgba(145, 78, 97, 0.35);
  border-color: rgba(145, 78, 97, 0.55);
}
.footer-legal {
  margin-top: 40px;
  border-top: 1px solid rgba(237, 230, 222, 0.16);
  background: transparent;
}
.footer-legal__inner {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 16px 24px;
  min-height: 56px;
  padding-top: 18px;
  padding-bottom: 22px;
}
.footer-legal__copy {
  margin: 0;
  justify-self: start;
  font-family: var(--sans);
  font-size: 13px;
  line-height: 1.4;
  color: #ddd1c5;
}
.footer-legal__dot {
  margin: 0 0.35em;
  opacity: 0.7;
}
.footer-legal__brand {
  justify-self: center;
  display: inline-flex;
  align-items: baseline;
  margin: 0 !important;
  font-family: var(--serif);
  font-size: 22px;
  letter-spacing: 0.02em;
  color: #fff !important;
  text-decoration: none;
  line-height: 1;
}
.footer-legal__brand b {
  font-weight: 400;
  color: var(--berry);
}
.footer-legal__terms {
  justify-self: end;
  margin: 0 !important;
  font-family: var(--sans);
  font-size: 13px;
  font-weight: 500;
  color: #ddd1c5 !important;
  text-decoration: underline;
  text-underline-offset: 3px;
  text-decoration-thickness: 1px;
}
.footer-legal__links {
  justify-self: end;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}
.footer-legal__links .footer-legal__dot { color: #ddd1c5; }
.footer-legal__terms:hover {
  color: #fff !important;
}
.footer-col { margin: 0; }
.footer-col > summary { list-style: none; cursor: default; }
.footer-col > summary::-webkit-details-marker { display: none; }
.footer-col--legal { display: none; }
@media (min-width: 761px) {
  .footer .footer-grid { grid-template-columns: 1.35fr .8fr .8fr .8fr; }
}
@media (max-width: 760px) {
  .footer .footer-grid { gap: 0; }
  .footer .footer-grid > div:first-child { margin-bottom: 18px; }
  .footer-col { border-top: 1px solid rgba(237, 230, 222, 0.16); }
  .footer-col--legal { display: block; border-bottom: 1px solid rgba(237, 230, 222, 0.16); }
  .footer-col > summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
  }
  .footer-col > summary h4 { margin: 0; font-size: 22px; }
  .footer-col > summary::after {
    content: "";
    width: 9px; height: 9px;
    border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg); margin-right: 6px; transition: transform .2s ease;
  }
  .footer-col[open] > summary::after { transform: rotate(-135deg); }
  .footer-col__links { padding-bottom: 12px; }
  .footer .footer-col__links a { padding: 6px 0; margin: 0; }
  /* Legal links live in the Legal section on mobile, so T&C shows once. */
  .footer .footer-legal__links { display: none; }
  .footer-legal__inner {
    grid-template-columns: 1fr;
    justify-items: center;
    text-align: center;
    gap: 10px;
    padding-top: 18px;
    padding-bottom: 18px;
  }
  .footer-legal__copy,
  .footer-legal__brand,
  .footer-legal__terms,
  .footer-legal__links {
    justify-self: center;
  }
}
{% endstylesheet %}
<script>
  (function () {
    var mq = window.matchMedia('(max-width: 760px)');
    function sync() {
      document.querySelectorAll('[data-footer-col]').forEach(function (d) {
        if (mq.matches) { d.removeAttribute('open'); } else { d.setAttribute('open', ''); }
      });
    }
    document.addEventListener('click', function (e) {
      var s = e.target.closest && e.target.closest('[data-footer-col] > summary');
      if (s && !mq.matches) e.preventDefault();
    });
    if (mq.addEventListener) mq.addEventListener('change', sync);
    sync();
  })();
</script>

