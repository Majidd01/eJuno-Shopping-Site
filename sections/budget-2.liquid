{%- comment -%} Card 725: euro label for the budget donut (ejuno.css untouched) {%- endcomment -%}<style>.donut:after{content:"\20AC 48k"}</style>
<section class="section tight"><div class="container"><div class="budget-shell"><div class="budget-card"><div class="eyebrow">{{ section.settings.eyebrow }}</div><div class="donut"></div><div style="text-align:center;color:var(--muted)">Allocated across venue, food, styling, media and remaining categories.</div></div><div class="budget-card"><div class="eyebrow">Category view</div><div class="bars"><div class="bar"><div class="bar-label"><span>Venue</span><strong>€19,500</strong></div><div class="bar-track"><div class="bar-fill" style="width:82%"></div></div></div><div class="bar"><div class="bar-label"><span>Food & drink</span><strong>€11,200</strong></div><div class="bar-track"><div class="bar-fill" style="width:62%"></div></div></div><div class="bar"><div class="bar-label"><span>Styling</span><strong>€5,300</strong></div><div class="bar-track"><div class="bar-fill" style="width:38%"></div></div></div><div class="bar"><div class="bar-label"><span>Photography</span><strong>€4,900</strong></div><div class="bar-track"><div class="bar-fill" style="width:34%"></div></div></div></div><div style="margin-top:22px"><a class="btn primary" href="https://ejuno-staging.web.app/couple-dashboard">Open Budget Planner</a></div></div></div></div></section>

{% schema %}
{
  "name": "budget 2",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Overall budget"
    }
  ],
  "presets": [
    {
      "name": "budget 2"
    }
  ]
}
{% endschema %}
