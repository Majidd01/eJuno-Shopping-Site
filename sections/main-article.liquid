{% schema %}
{
  "name": "Article",
  "tag": "section",
  "class": "ejuno-section",
  "settings": [
    { "type": "text", "id": "fallback_author", "label": "Author shown for admin-written stories", "default": "eJuno Team" },
    {
      "type": "text",
      "id": "eyebrow_fallback",
      "label": "Fallback eyebrow",
      "default": "Inspiration"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_next_prev",
      "label": "Show previous / next links",
      "default": true
    }
  ]
}
{% endschema %}
