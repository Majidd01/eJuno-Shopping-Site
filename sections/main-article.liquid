{{ 'ejuno-article.css' | asset_url | stylesheet_tag }}

{% liquid
  assign show_author = section.settings.show_author
  assign show_date = section.settings.show_date
  assign show_pager = section.settings.show_next_prev
  assign eyebrow = section.settings.eyebrow_fallback
  if article.tags.size > 0
    assign eyebrow = article.tags.first
  elsif blog.title != blank
    assign eyebrow = blog.title
  endif
%}

<article
  class="ejuno-article"
  itemscope
  itemtype="http://schema.org/BlogPosting"
  id="ArticleSection-{{ section.id }}"
>
  <div class="container ejuno-article__wrap">
    <nav class="ejuno-article__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ blog.url }}">← {{ blog.title }}</a>
    </nav>

    <header class="ejuno-article__head">
      <p class="eyebrow">{{ eyebrow }}</p>
      <h1 class="h1 ejuno-article__title" itemprop="headline">{{ article.title }}</h1>
      {% if article.excerpt != blank %}
        <p class="ejuno-article__excerpt lead">{{ article.excerpt }}</p>
      {% endif %}
      {% if show_author or show_date %}
        <div class="ejuno-article__meta">
          {% if show_author %}
            {%- render 'ejuno-article-author', article: article, fallback: section.settings.fallback_author -%}
          {% endif %}
          {% if show_author and show_date %}
            <span class="ejuno-article__meta-divider" aria-hidden="true"></span>
          {% endif %}
          {% if show_date %}
            <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}" itemprop="datePublished">
              {{ article.published_at | date: '%d %b %Y' }}
            </time>
          {% endif %}
        </div>
      {% endif %}
    </header>

    {%- comment -%} Card 729: client replacement photo for the Florence-couple article {%- endcomment -%}
    {%- comment -%} Trello 794: approved images per article (until/unless set as featured images in admin). {%- endcomment -%}
    {%- liquid
      assign ej794_art = ''
      if article.handle contains 'will-your-family-and-friends'
        assign ej794_art = 'ejuno-article-2-4.jpg'
        assign ej794_art_alt = 'Guests sharing a long dinner table in an Italian garden at sunset'
      elsif article.handle contains 'the-best-months-to-get-married-in-italy'
        assign ej794_art = 'ejuno-article-2-3.jpg'
        assign ej794_art_alt = 'Lakeside terrace wedding table dressed with white flowers'
      elsif article.handle contains 'wedding-website-must-haves'
        assign ej794_art = 'ejuno-article-2-2.jpg'
        assign ej794_art_alt = 'Laptop showing a wedding website on a garden table'
      elsif article.handle contains 'choosing-the-perfect-setting'
        assign ej794_art = 'ejuno-article-1-6.jpg'
        assign ej794_art_alt = 'Bride and groom on a terrace above an Italian lake town'
      endif
    -%}
    {% if ej794_art != blank %}
      <figure class="ejuno-article__hero">
        <img src="{{ ej794_art | asset_url }}" alt="{{ ej794_art_alt | escape }}" width="2000" height="1121" sizes="(min-width: 900px) 1080px, 100vw" loading="eager" itemprop="image">
      </figure>
    {% elsif article.image %}
      <figure class="ejuno-article__hero">
        <img
          src="{{ article.image | image_url: width: 1600 }}"
          srcset="
            {{ article.image | image_url: width: 800 }} 800w,
            {{ article.image | image_url: width: 1200 }} 1200w,
            {{ article.image | image_url: width: 1600 }} 1600w,
            {{ article.image | image_url: width: 2400 }} 2400w
          "
          sizes="(min-width: 900px) 1080px, 100vw"
          alt="{{ article.image.alt | default: article.title | escape }}"
          width="{{ article.image.width }}"
          height="{{ article.image.height }}"
          loading="eager"
          itemprop="image"
        >
      </figure>
    {% endif %}

    <div class="ejuno-article__body rte article-body" itemprop="articleBody">
      {{ article.content | replace: '\n', '' }}
    </div>

    {% if show_pager %}
      {% liquid
        assign prev_i = -1
        assign next_i = -1
        for a in blog.articles
          if a.id == article.id
            assign prev_i = forloop.index0 | minus: 1
            assign next_i = forloop.index0 | plus: 1
          endif
        endfor
        assign prev_article = nil
        assign next_article = nil
        if prev_i >= 0
          assign prev_article = blog.articles[prev_i]
        endif
        if next_i < blog.articles.size
          assign next_article = blog.articles[next_i]
        endif
      %}
      {% if prev_article or next_article %}
        <nav class="ejuno-article__pager" aria-label="Article navigation">
          {% if prev_article %}
            <a class="ejuno-article__pager-link ejuno-article__pager-link--prev" href="{{ prev_article.url }}">
              <span class="ejuno-article__pager-label">Previous</span>
              <span class="ejuno-article__pager-title">{{ prev_article.title }}</span>
            </a>
          {% else %}
            <span class="ejuno-article__pager-spacer" aria-hidden="true"></span>
          {% endif %}
          {% if next_article %}
            <a class="ejuno-article__pager-link ejuno-article__pager-link--next" href="{{ next_article.url }}">
              <span class="ejuno-article__pager-label">Next</span>
              <span class="ejuno-article__pager-title">{{ next_article.title }}</span>
            </a>
          {% endif %}
        </nav>
      {% endif %}
    {% endif %}
  </div>

  <div id="ejunoModal" class="ejuno-article-modal" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="ejuno-modal-title">
    <div class="ejuno-article-modal__backdrop" data-ejuno-modal-close tabindex="-1"></div>
    <div class="ejuno-article-modal__dialog">
      <button type="button" class="ejuno-article-modal__close" data-ejuno-modal-close aria-label="Close">&times;</button>
      <h2 id="ejuno-modal-title" class="ejuno-article-modal__title">Wedding concierge</h2>
      <p class="ejuno-article-modal__lead">Share a few details and our team will reach out to help with your Italy wedding plans.</p>

      <div id="ejunoSuccessMsg" class="ejuno-article-modal__msg ejuno-article-modal__msg--success">
        Thank you! Our concierge will contact you soon.
      </div>
      <div id="ejunoErrorMsg" class="ejuno-article-modal__msg ejuno-article-modal__msg--error">
        Something went wrong. Please try again.
      </div>

      <form id="ejunoForm">
        <div class="ejuno-article-modal__field">
