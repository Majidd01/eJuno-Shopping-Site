
<section class="utility-head"><div class="container"><div class="eyebrow">Account</div><h1 class="h1">Create account</h1>
{% form 'create_customer' %}{{ form.errors | default_errors }}
<div class="utility-panel" style="max-width:480px;margin:24px auto 0">
  <div class="field" style="margin-bottom:12px"><input type="text" name="customer[first_name]" placeholder="First name"></div>
  <div class="field" style="margin-bottom:12px"><input type="text" name="customer[last_name]" placeholder="Last name"></div>
  <div class="field" style="margin-bottom:12px"><input type="email" name="customer[email]" placeholder="Email" required></div>
  <div class="field" style="margin-bottom:12px"><input type="password" name="customer[password]" placeholder="Password" required></div>
  <button class="btn primary" type="submit">Create account</button>
</div>{% endform %}</div></section>

{% schema %}
{
  "name": "Customer register",
  "settings": []
}
{% endschema %}
