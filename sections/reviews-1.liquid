<section class="review-hero">
  <div class="container review-hero__inner">
    <div class="review-copy">
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      <h1 class="h1">{{ section.settings.heading }}</h1>
      <p class="lead">{{ section.settings.lead }}</p>
      <a href="/pages/contact" class="btn primary">Talk to eJuno</a>
    </div>
    <figure class="review-hero__media">
      <img
        src="{% if section.settings.image_1 != blank %}{{ section.settings.image_1 | image_url: width: 2000 }}{% else %}{{ section.settings.fallback_1 | asset_url }}{% endif %}"
        width="1672"
        height="941"
        loading="lazy"
        alt=""
      >
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "reviews 1",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1 (ejuno-photo-11.jpg)"
    },
    {
      "type": "text",
      "id": "fallback_1",
      "label": "Fallback asset 1",
      "default": "ejuno-photo-11.jpg"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Confidence Comes From People Who've Done It"
    },
    {
      "type": "text",
      "id": "lead",
      "label": "Lead",
      "default": "Real words from couples and professionals who have planned with eJuno."
    }
  ],
  "presets": [
    {
      "name": "reviews 1"
    }
  ]
}
{% endschema %}
