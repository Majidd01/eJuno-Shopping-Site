<section class="section tools-band tools-band--list">
  <div class="container tools-list-layout">
    {%- comment -%} Trello 670: review p29 (05.02) layout. Photo on the left, the five tools as a simple list on the right. {%- endcomment -%}
    <div class="tools-photo">
      {%- if section.settings.photo != blank -%}
        {{ section.settings.photo | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 990px) 45vw, 100vw', alt: section.settings.photo.alt | default: section.settings.heading }}
      {%- else -%}
        <img src="{{ 'ejuno-photo-01.jpg' | asset_url }}" alt="" loading="lazy" width="1122" height="1402">
      {%- endif -%}
    </div>
    <div class="tools-list-col">
    <div class="section-head">
      <div class="copy">
        <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        <h2 class="h2">{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
      </div>
    </div>
    <div class="tools-grid">
      {% for block in section.blocks %}
        <a class="tool-link" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
          {%- if section.settings.show_numbers -%}
            <span class="num">{{ block.settings.num }}</span>
          {%- else -%}
            {%- comment -%} Review p17: icons instead of 01–05, since the tools aren't steps. {%- endcomment -%}
            {%- assign t_key = block.settings.title | downcase -%}
            <span class="tool-icon" aria-hidden="true">
              {%- if t_key contains 'website' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="15" rx="2"/><path d="M3 8.5h18M6.5 6.2h.01M9 6.2h.01"/></svg>
              {%- elsif t_key contains 'registry' or t_key contains 'gift' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="8.5" width="17" height="12" rx="1.5"/><path d="M2.5 8.5h19v-1a1 1 0 0 0-1-1h-17a1 1 0 0 0-1 1zM12 6.5v14M12 6.5S10.5 3 8.3 3.6C6.6 4 7 6.5 9 6.5M12 6.5s1.5-3.5 3.7-2.9C17.4 4 17 6.5 15 6.5"/></svg>
              {%- elsif t_key contains 'guest' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3 19.5c.6-3.2 3-5 6-5s5.4 1.8 6 5"/><circle cx="17" cy="9" r="2.4"/><path d="M16.5 14.2c2.3.2 3.9 1.7 4.5 4.3"/></svg>
              {%- elsif t_key contains 'budget' -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v9M14.6 9.4c-.5-.8-1.5-1.3-2.6-1.3-1.5 0-2.6.8-2.6 1.9 0 2.6 5.3 1.5 5.3 4.1 0 1.1-1.2 2-2.7 2-1.2 0-2.2-.5-2.7-1.4"/></svg>
              {%- else -%}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3.5" width="16" height="17" rx="2"/><path d="M8 9l1.6 1.6L12.5 7.7M8 15l1.6 1.6 2.9-2.9M14.5 9.5H17M14.5 15.5H17"/></svg>
              {%- endif -%}
            </span>
          {%- endif -%}
          <div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
      {%- if section.settings.show_cta and section.settings.cta_label != blank -%}
        <div class="tools-cta">
          <a class="btn primary tools-cta__btn" href="{{ section.settings.cta_url | default: 'https://ejuno-staging.web.app/couple-dashboard/my-wedding' }}">{{ section.settings.cta_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
<style>
  .tools-band .tools-cta { display: flex; justify-content: flex-start; margin-top: 28px; }
  .tools-band .tools-cta__btn { background: var(--plum, #7a3f52) !important; border-color: var(--plum, #7a3f52) !important; color: #fff !important; border-radius: 999px; min-width: 260px; justify-content: center; text-align: center; text-decoration: none; transition: background-color .2s, border-color .2s; }
  .tools-band .tools-cta__btn:hover, .tools-band .tools-cta__btn:focus-visible { background: #6a3446 !important; border-color: #6a3446 !important; color: #fff !important; }
  @media (max-width: 600px) { .tools-band .tools-cta { margin-top: 28px; } .tools-band .tools-cta__btn { width: 100%; min-width: 0; } }
  /* Trello 659: darker grey for 4.5:1+ contrast on the beige band. Trello 656 #8: all tools in one row on desktop. */
  .tools-band .section-head p,
  .tools-band .tool-link p { color: #5a524b; }
  @media (min-width: 1101px) {
    .tools-band .tools-grid { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr)); gap: 14px; }
    .tools-band .tool-link { padding: 22px; }
  }
  .tools-band .tool-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%;
    background: rgba(155, 80, 104, 0.1); color: #7e3d55; flex: none;
  }
  /* Trello 670: list layout from the review (no boxes or shadows, thin dividers). */
  .tools-band--list .tools-list-layout { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 56px; align-items: center; }
  .tools-band--list .tools-photo { border-radius: 20px; overflow: hidden; aspect-ratio: 4 / 5; background: #e7e1d9; }
  .tools-band--list .tools-photo img { width: 100%; height: 100%; object-fit: cover; object-position: right; display: block; }
  .tools-band--list .section-head { margin-bottom: 18px; }
  .tools-band--list .tools-grid { display: block !important; border-top: 1px solid var(--line, #e2d9cf); }
  .tools-band--list .tool-link {
    display: flex !important; flex-direction: row !important; align-items: center !important; gap: 18px;
    min-height: 0 !important; padding: 18px 4px !important; background: none !important; border: 0 !important;
    border-bottom: 1px solid var(--line, #e2d9cf) !important; border-radius: 0 !important; box-shadow: none !important;
    text-decoration: none; transition: color .2s;
  }
  .tools-band--list .tool-link > div { display: grid; grid-template-columns: minmax(150px, 220px) 1fr; gap: 6px 20px; align-items: baseline; flex: 1; }
  .tools-band--list .tool-link h3 { margin: 0 !important; font-size: 24px !important; line-height: 1.2; }
  .tools-band--list .tool-link p { margin: 0; font-size: 15px; }
  .tools-band--list .tool-link:hover h3 { color: var(--berry, #9b5068); }
  @media (max-width: 989px) {
    .tools-band--list .tools-list-layout { grid-template-columns: 1fr; gap: 28px; }
    .tools-band--list .tools-photo { aspect-ratio: 16 / 10; }
    .tools-band--list .tool-link > div { grid-template-columns: 1fr; gap: 2px; }
    .tools-band--list .tool-link h3 { font-size: 21px !important; }
  }
</style>

{% schema %}
{
  "name": "Home tools",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "photo",
      "label": "Photo (left)",
      "info": "Review suggestion: a planning moment, e.g. hands on a notebook with flowers. Falls back to the planning photo."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Planning tools"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything you need, without the clutter"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Keep the practical side of planning in one place."
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Show numbers instead of icons",
      "default": false
    },
    { "type": "header", "content": "Button" },
    { "type": "checkbox", "id": "show_cta", "label": "Show button", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Start Planning" },
    { "type": "url", "id": "cta_url", "label": "Button link", "info": "Leave empty to use the couple dashboard." }
  ],
  "blocks": [
    {
      "type": "tool",
      "name": "Tool",
      "settings": [
        {
          "type": "text",
          "id": "num",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Wedding Website"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Give guests one beautiful place for the details."
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home tools",
      "blocks": [
        {
          "type": "tool",
          "settings": {
            "num": "01",
            "title": "Wedding Website",
            "text": "Give guests one beautiful place for the details.",
            "url": "/pages/wedding-website"
          }
        },
        {
          "type": "tool",
          "settings": {
            "num": "02",
            "title": "Registry",
            "text": "Add your favourite venues and wedding services to your registry and share it with guests so they can contribute to your special day.",
            "url": "/pages/registry"
          }
        },
        {
          "type": "tool",
          "settings": {
            "num": "03",
            "title": "Guest List",
            "text": "Keep RSVPs and households clear.",
            "url": "/pages/guest-list"
          }
        },
        {
          "type": "tool",
          "settings": {
            "num": "04",
            "title": "Budget",
            "text": "See the financial picture without spreadsheet chaos.",
            "url": "/pages/budget"
          }
        },
        {
          "type": "tool",
          "settings": {
            "num": "05",
            "title": "Checklist",
            "text": "Know what matters next.",
            "url": "/pages/wedding-check-list"
          }
        }
      ]
    }
  ]
}
{% endschema %}
