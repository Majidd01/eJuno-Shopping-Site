<section class="plan-intro"><div class="container"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1 class="h1">{{ section.settings.heading }}</h1><p class="lead">{{ section.settings.text }}</p></div></section>

{% schema %}
{
  "name": "Plan hero",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Plan your wedding"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three phases. Six planning tools."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Start with the roadmap: shape the day, organise people and budget, then share with guests. When you are ready, open the tool that matches what you need to do next."
    }
  ],
  "presets": [
    {
      "name": "Plan hero"
    }
  ]
}
{% endschema %}
