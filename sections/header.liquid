{{ 'ejuno-megamenu.css' | asset_url | stylesheet_tag }}
{{ 'ejuno-header-search.css' | asset_url | stylesheet_tag }}
{%- comment -%} Trello 689: mobile For Vendors button, header fit at 375px, card image fit. {%- endcomment -%}
{{ 'ejuno-1022-689.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ejuno-header-search.js' | asset_url }}" defer></script>

{% liquid
  assign overlay_home = false
  if template.name == 'index' and section.settings.transparent_over_hero
    assign overlay_home = true
  endif
%}
<div
  class="header{% if overlay_home %} header--home-overlay{% endif %}"
  {% if overlay_home %}data-header-overlay{% endif %}
>
  <div class="header-bar">
  <div class="header-inner">
    {% liquid
      assign logo_word = section.settings.logo_text | default: 'Juno'
      assign logo_first = logo_word | slice: 0
      assign logo_rest = logo_word | slice: 1, 64
    %}
    <a class="logo" href="{{ routes.root_url }}">
      {%- comment -%} Brand logo 2026-10-23: colour SVG (PNG fallback) from theme assets. {%- endcomment -%}
      <picture class="logo-img logo-img--color"><source srcset="{{ 'ejuno-logo-color.svg' | asset_url }}" type="image/svg+xml"><img src="{{ 'ejuno-logo-color.png' | asset_url }}" alt="eJuno" width="944" height="416" decoding="async"></picture>
      {%- if section.settings.logo_tagline != blank -%}<span class="logo-tagline">{{ section.settings.logo_tagline }}</span>{%- endif %}
    </a>
    <nav class="nav nav-primary" aria-label="Primary">
      {% liquid
        assign ejuno_pdp_kind = ''
        if template.name == 'product' and product != blank
          assign ejuno_pt = product.type | downcase | strip
          assign ejuno_vt = product.metafields.custom.vendorType.value | default: product.metafields.custom.vendorType | downcase | strip
          if ejuno_pt == 'service' or ejuno_vt == 'service'
            assign ejuno_pdp_kind = 'service'
          elsif ejuno_pt == 'product' or ejuno_vt == 'product' or ejuno_vt contains 'product vendor'
            assign ejuno_pdp_kind = 'shop'
          else
            for tag in product.tags
              assign ejuno_tag = tag | downcase | strip
              if ejuno_tag == 'catalog' or ejuno_tag == 'shop' or ejuno_tag == 'shop product' or ejuno_tag == 'registry product'
                assign ejuno_pdp_kind = 'shop'
                break
              endif
            endfor
          endif
          if ejuno_pdp_kind == blank
            assign ejuno_in_venues = false
            for col in product.collections
              assign col_handle = col.handle | downcase
              if col_handle == 'venues'
                assign ejuno_in_venues = true
                break
              endif
            endfor
            if ejuno_pt == 'venue' or ejuno_vt == 'venue' or ejuno_vt contains 'venue' or ejuno_in_venues
              assign ejuno_pdp_kind = 'venue'
            else
              # Catalog/shop goods often have blank type — default those PDPs to Shop, not Explore.
              assign ejuno_pdp_kind = 'shop'
            endif
          endif
        endif
      %}
      {% for link in section.blocks %}
        {% if link.type == 'nav_link' and link.settings.placement != 'beside_cta' %}
          {% liquid
            assign megamenu = link.settings.megamenu | default: 'none'
            assign nav_label = link.settings.label | downcase | strip
            if megamenu == 'none' or megamenu == blank
              if nav_label == 'explore' or nav_label contains 'book a venue' or nav_label contains 'venues'
                assign megamenu = 'explore'
              elsif nav_label == 'services' or nav_label contains 'wedding services' or nav_label contains 'reserve your'
                assign megamenu = 'services'
              endif
            endif
            assign ejuno_nav_active = false
            assign nav_path = request.path
            capture nav_url_full
              render 'ejuno-blog-href', url: link.settings.url
            endcapture
            assign nav_url = nav_url_full | strip | split: '?' | first
            if nav_url != blank and nav_url != '/' and nav_path == nav_url
              assign ejuno_nav_active = true
            elsif nav_url != blank and nav_url != '/' and nav_url.size > 1 and nav_path contains nav_url
              unless megamenu == 'explore' and template.name == 'product'
                assign ejuno_nav_active = true
              endunless
            endif
            if nav_url == '/pages/vendor' and nav_path != '/pages/vendor'
              assign ejuno_nav_active = false
            endif
            if megamenu == 'explore'
              if nav_path contains '/collections/venue' or nav_path contains '/collections/accommodation' or nav_path contains '/collections/villa'
                assign ejuno_nav_active = true
              elsif ejuno_pdp_kind == 'venue'
                assign ejuno_nav_active = true
              elsif template.name == 'product'
                assign ejuno_nav_active = false
              endif
            elsif megamenu == 'services'
              if nav_path contains 'all-services'
                assign ejuno_nav_active = true
              elsif ejuno_pdp_kind == 'service'
                assign ejuno_nav_active = true
              elsif template.name == 'product'
                assign ejuno_nav_active = false
              endif
            endif
          %}
          {% if megamenu == 'explore' %}
            {% liquid
              assign megamenu_href = link.settings.url | default: '/collections/venues'
              if megamenu_href == blank
                assign megamenu_href = '/collections/venues'
              endif
            %}
            <div class="nav-item nav-item--megamenu{% if ejuno_nav_active %} is-current{% endif %}" data-nav-megamenu>
              <a
                href="{{ megamenu_href }}"
                class="nav-megamenu-trigger{% if ejuno_nav_active %} active{% endif %}"
                aria-expanded="false"
                aria-controls="explore-megamenu"
                id="nav-explore-trigger"
                {% if ejuno_nav_active %}aria-current="page"{% endif %}
              >
                {{ link.settings.label }}
                <svg class="nav-megamenu-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          {% elsif megamenu == 'services' %}
            {% liquid
              assign megamenu_href = link.settings.url | default: '/pages/all-services'
              if megamenu_href == blank
                assign megamenu_href = '/pages/all-services'
              endif
            %}
            <div class="nav-item nav-item--megamenu{% if ejuno_nav_active %} is-current{% endif %}" data-nav-megamenu>
              <a
                href="{{ megamenu_href }}"
                class="nav-megamenu-trigger{% if ejuno_nav_active %} active{% endif %}"
                aria-expanded="false"
                aria-controls="services-megamenu"
                id="nav-services-trigger"
                {% if ejuno_nav_active %}aria-current="page"{% endif %}
              >
                {{ link.settings.label }}
                <svg class="nav-megamenu-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          {% else %}
            <a href="{%- render 'ejuno-blog-href', url: link.settings.url -%}"{% if ejuno_nav_active %} class="active" aria-current="page"{% endif %}>{{ link.settings.label }}</a>
          {% endif %}
        {% endif %}
      {% endfor %}
      {% if section.settings.show_shop_menu %}
        {% liquid
          assign ejuno_shop_active = false
          assign nav_path = request.path
          assign shop_href = section.settings.shop_url | default: '/collections/new-arrivals'
          if shop_href == blank
            assign shop_href = '/collections/new-arrivals'
          endif
          if ejuno_pdp_kind == 'shop'
            assign ejuno_shop_active = true
          elsif template.name == 'collection' and collection.handle != 'venues'
            unless collection.handle contains 'service' or collection.handle == 'all-services' or collection.handle == 'photo-film' or collection.handle == 'design-artistry' or collection.handle == 'gastronomy-bar' or collection.handle == 'entertainment-1' or collection.handle == 'beauty-fashion' or collection.handle == 'enhancements' or collection.handle == 'transport'
              assign ejuno_shop_active = true
            endunless
          elsif nav_path contains '/collections/'
            unless nav_path contains '/collections/venues' or nav_path contains 'all-services' or nav_path contains '/collections/photo-film' or nav_path contains '/collections/design-artistry' or nav_path contains '/collections/gastronomy' or nav_path contains '/collections/entertainment' or nav_path contains '/collections/beauty-fashion' or nav_path contains '/collections/enhancements' or nav_path contains '/collections/transport'
              assign ejuno_shop_active = true
            endunless
          endif
        %}
        <div class="nav-item nav-item--megamenu{% if ejuno_shop_active %} is-current{% endif %}" data-nav-megamenu data-shop-nav>
          <a
            href="{{ shop_href }}"
            class="nav-megamenu-trigger nav-shop-trigger{% if ejuno_shop_active %} active{% endif %}"
            id="nav-shop-trigger"
            aria-expanded="false"
            aria-controls="shop-megamenu"
            {% if ejuno_shop_active %}aria-current="page"{% endif %}
          >
            {{ section.settings.shop_label | default: 'Shop' }}
            <svg class="nav-megamenu-chevron nav-shop-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      {% endif %}
    </nav>
    {% if section.settings.show_search_icon %}
      <div class="ejuno-header-search-slot">
        {% render 'ejuno-header-search-panel' %}
      </div>
    {% endif %}
    <div class="header-actions">
      {% if section.settings.show_search_icon %}
        <button
          type="button"
          class="header-icon header-icon--search"
          data-ejuno-header-search-toggle
          aria-expanded="false"
          aria-controls="ejuno-header-search-panel"
          aria-label="Search"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.75"/><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
        </button>
      {% endif %}
      {% if section.settings.show_account_menu %}
        {% render 'ejuno-header-account' %}
      {% endif %}
      {% if section.settings.show_wishlist_icon %}
        <a class="header-icon" href="{{ section.settings.wishlist_url | default: routes.root_url }}" aria-label="Saved">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20.5s-7-4.35-7-10a4 4 0 0 1 7-2.5 4 4 0 0 1 7 2.5c0 5.65-7 10-7 10z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>
        </a>
      {% endif %}
      {% if section.settings.show_cart_icon %}
        <button type="button" class="header-icon header-icon--cart" data-ejuno-cart-open aria-label="Open cart">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6h15l-1.5 9h-12L6 6z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
            <path d="M6 6L5 3H2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="9" cy="20" r="1.25" fill="currentColor"/>
            <circle cx="18" cy="20" r="1.25" fill="currentColor"/>
          </svg>
          <span class="header-cart-count" data-ejuno-cart-count hidden>0</span>
        </button>
      {% endif %}
      {%- assign ej_util_active = false -%}{%- if request.path == section.settings.utility_url or request.path contains '/pages/couple-wedding-website' -%}{%- assign ej_util_active = true -%}{%- endif -%}
      <a href="{{ section.settings.utility_url }}" class="header-cta header-cta--wedding{% if ej_util_active %} is-active{% endif %}"{% if ej_util_active %} aria-current="page"{% endif %}>
        <span class="header-cta__label">{{ section.settings.utility_label }}</span>
      </a>
      {%- comment -%} Trello 657: links placed after the wedding button (e.g. For Vendors). {%- endcomment -%}
      {%- for link in section.blocks -%}
        {%- if link.type == 'nav_link' and link.settings.placement == 'beside_cta' -%}
          {%- assign bc_url = link.settings.url | default: '/pages/vendor' -%}
          <a href="{{ bc_url }}" class="header-beside-cta{% if request.path == bc_url %} active is-active{% endif %}"{% if request.path == bc_url %} aria-current="page"{% endif %}>{{ link.settings.label }}</a>
        {%- endif -%}
      {%- endfor -%}
      <button
        type="button"
        class="header-menu-toggle"
        data-mobile-nav-toggle
        aria-expanded="false"
        aria-controls="ejuno-mobile-nav"
      >
        <span class="visually-hidden">Open menu</span>
        <svg class="header-menu-toggle__open" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        </svg>
        <svg class="header-menu-toggle__close" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
  </div>
  <div class="mobile-nav-backdrop" data-mobile-nav-backdrop hidden></div>
  <nav id="ejuno-mobile-nav" class="mobile-nav" aria-label="Mobile" hidden>
    <div class="mobile-nav__head">
      <span class="mobile-nav__title">Menu</span>
      <button type="button" class="mobile-nav__close" data-mobile-nav-close aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <div class="mobile-nav__links">
      {% for link in section.blocks %}
        {% if link.type == 'nav_link' and link.settings.placement != 'beside_cta' %}
          {% liquid
            capture mobile_href
              render 'ejuno-blog-href', url: link.settings.url
            endcapture
            assign mobile_href = mobile_href | strip
            assign megamenu = link.settings.megamenu | default: 'none'
            assign nav_label = link.settings.label | downcase | strip
            if nav_label == 'search'
              continue
            endif
            if megamenu == 'none' or megamenu == blank
              if nav_label == 'explore' or nav_label contains 'book a venue' or nav_label contains 'venues'
                assign megamenu = 'explore'
              elsif nav_label == 'services' or nav_label contains 'wedding services' or nav_label contains 'reserve your'
                assign megamenu = 'services'
              endif
            endif
            if megamenu == 'explore' and mobile_href == blank
              assign mobile_href = '/collections/venues'
            elsif megamenu == 'services' and mobile_href == blank
              assign mobile_href = '/pages/all-services'
            endif
          %}
          {% if megamenu == 'explore' %}
            <details class="mobile-nav__details">
              <summary class="mobile-nav__link mobile-nav__summary">{{ link.settings.label }}</summary>
              <div class="mobile-nav__sub">
                {% render 'ejuno-megamenu-mobile-explore', venue_url: section.settings.venues_url, accommodation_url: section.settings.accommodation_url, villa_url: section.settings.villa_url, types: section.settings.accommodation_types %}
              </div>
            </details>
          {% elsif megamenu == 'services' %}
            <details class="mobile-nav__details">
              <summary class="mobile-nav__link mobile-nav__summary">{{ link.settings.label }}</summary>
              <div class="mobile-nav__sub">
                {% render 'ejuno-megamenu-mobile-services' %}
              </div>
            </details>
          {% else %}
            <a class="mobile-nav__link" href="{{ mobile_href | default: routes.root_url }}">{{ link.settings.label }}</a>
          {% endif %}
        {% endif %}
      {% endfor %}
      {% if section.settings.show_shop_menu %}
        <details class="mobile-nav__details">
          <summary class="mobile-nav__link mobile-nav__summary">{{ section.settings.shop_label | default: 'Shop' }}</summary>
          <div class="mobile-nav__sub">
            {% render 'ejuno-megamenu-mobile-shop' %}
          </div>
        </details>
      {% endif %}
      {% if section.settings.show_account_menu %}
        {% liquid
          assign couple_url = section.settings.login_couple_url | default: 'https://ejuno-staging.web.app/couple-dashboard'
          assign vendor_url = section.settings.login_vendor_url | default: 'https://vendor-staging-ejuno.web.app/'
          assign guest_url = section.settings.login_guest_url | default: 'https://ejuno-staging.web.app/guest/login'
        %}
        <div
          class="mobile-nav__account"
          data-mobile-account
          data-url-couple="{{ couple_url | escape }}"
          data-url-vendor="{{ vendor_url | escape }}"
          data-url-guest="{{ guest_url | escape }}"
        >
          <div class="mobile-nav__account-head" data-mobile-account-head>
            <span class="mobile-nav__account-label" data-mobile-account-label>Account</span>
          </div>
          <div class="mobile-nav__account-body" data-mobile-account-logged-out>
            <a class="mobile-nav__link mobile-nav__link--account" href="{{ couple_url }}">Login as Couple</a>
            <a class="mobile-nav__link mobile-nav__link--account" href="{{ vendor_url }}">Login as Vendor</a>
            <a class="mobile-nav__link mobile-nav__link--account" href="{{ guest_url }}">Event Guest</a>
          </div>
          <div class="mobile-nav__account-body mobile-nav__account-body--signed-in" data-mobile-account-logged-in hidden>
            <div class="mobile-nav__account-card">
              <span class="mobile-nav__account-status">Signed in</span>
              <p class="mobile-nav__account-name" data-mobile-account-name>Your account</p>
              <p class="mobile-nav__account-role" data-mobile-account-role>Couple account</p>
            </div>
            <a class="mobile-nav__link mobile-nav__link--account mobile-nav__link--dashboard" href="{{ couple_url }}" data-mobile-account-dashboard>Open couple dashboard</a>
            <button type="button" class="mobile-nav__link mobile-nav__link--account mobile-nav__link--button mobile-nav__link--signout" data-mobile-account-signout>Sign out</button>
          </div>
        </div>
      {% endif %}
    </div>
    <div class="mobile-nav__foot">
      <a class="mobile-nav__wedding-cta{% if ej_util_active %} is-active{% endif %}" href="{{ section.settings.utility_url }}"{% if ej_util_active %} aria-current="page"{% endif %}>{{ section.settings.utility_label }}</a>
      {%- for link in section.blocks -%}
        {%- if link.type == 'nav_link' and link.settings.placement == 'beside_cta' -%}
          {%- assign bc_url = link.settings.url | default: '/pages/vendor' -%}<a class="mobile-nav__beside-cta{% if request.path == bc_url %} active is-active{% endif %}" href="{{ bc_url }}"{% if request.path == bc_url %} aria-current="page"{% endif %}>{{ link.settings.label }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </nav>
  {%- comment -%} Trello 689 QA r3 (26-10-26): active-page fallback for Find a Wedding / For Vendors, and full-screen drawer scroll lock (iOS + Android). {%- endcomment -%}
  <script>(function(){
    function norm(p){return (p||'').replace(/\/+$/,'').toLowerCase()||'/';}
    var here=norm(location.pathname).replace(/^\/[a-z]{2}(-[a-z]{2})?(?=\/)/,'');
    document.querySelectorAll('.ejuno-header .header-cta--wedding,.ejuno-header .header-beside-cta,.mobile-nav__wedding-cta,.mobile-nav__beside-cta').forEach(function(a){
      var p;try{p=norm(new URL(a.getAttribute('href'),location.href).pathname);}catch(e){return;}
      var on=p===here||(a.matches('.header-cta--wedding,.mobile-nav__wedding-cta')&&here.indexOf('/pages/couple-wedding-website')===0);
      if(on){a.classList.add('is-active');a.setAttribute('aria-current','page');}
    });
    var html=document.documentElement,body=document.body,locked=false,y=0;
    function lock(){if(locked)return;locked=true;y=window.scrollY||html.scrollTop||0;
      html.classList.add('ej-nav-locked');html.style.overflow='hidden';body.style.overflow='hidden';
      body.style.position='fixed';body.style.top=(-y)+'px';body.style.left='0';body.style.right='0';body.style.width='100%';}
    function unlock(){if(!locked)return;locked=false;
      html.classList.remove('ej-nav-locked');html.style.overflow='';body.style.overflow='';
      body.style.position='';body.style.top='';body.style.left='';body.style.right='';body.style.width='';
      var sb=html.style.scrollBehavior;html.style.scrollBehavior='auto';window.scrollTo(0,y);html.style.scrollBehavior=sb;}
    function sync(){if(body.classList.contains('ejuno-mobile-nav-open'))lock();else unlock();}
    if(window.MutationObserver)new MutationObserver(sync).observe(body,{attributes:true,attributeFilter:['class']});
    window.addEventListener('resize',function(){if(locked&&window.innerWidth>1100){var t=document.querySelector('[data-mobile-nav-close]');if(t)t.click();}});
  })();</script>
  {%- comment -%} Trello 689 reopen (28-10-26): drawer Find a Wedding / For Vendors - softer selected colour
    (brand plum #9b5068 instead of dark #5e2a3d) and hover/tap/focus tint like the desktop header pills.
    :not(#ej689r4) adds specificity over the r3 rules in ejuno-1022-689.css. {%- endcomment -%}
  <style>
    html body .mobile-nav__foot .mobile-nav__wedding-cta:not(#ej689r4),
    html body .mobile-nav__foot .mobile-nav__beside-cta:not(#ej689r4){-webkit-tap-highlight-color:transparent;transition:background .2s,border-color .2s,color .2s}
    html body .mobile-nav__foot .mobile-nav__wedding-cta:not(#ej689r4):hover,
    html body .mobile-nav__foot .mobile-nav__wedding-cta:not(#ej689r4):focus-visible,
    html body .mobile-nav__foot .mobile-nav__wedding-cta:not(#ej689r4):active,
    html body .mobile-nav__foot .mobile-nav__wedding-cta.is-tapped:not(#ej689r4),
    html body .mobile-nav__foot .mobile-nav__beside-cta:not(#ej689r4):hover,
    html body .mobile-nav__foot .mobile-nav__beside-cta:not(#ej689r4):focus-visible,
    html body .mobile-nav__foot .mobile-nav__beside-cta:not(#ej689r4):active,
    html body .mobile-nav__foot .mobile-nav__beside-cta.is-tapped:not(#ej689r4){background:#f3e8ec !important;border-color:#9b5068 !important;color:#9b5068 !important;box-shadow:none !important;transform:none !important}
    html body .mobile-nav__foot .mobile-nav__wedding-cta.is-active:not(#ej689r4),
    html body .mobile-nav__foot .mobile-nav__wedding-cta[aria-current="page"]:not(#ej689r4),
    html body .mobile-nav__foot .mobile-nav__beside-cta.is-active:not(#ej689r4),
    html body .mobile-nav__foot .mobile-nav__beside-cta[aria-current="page"]:not(#ej689r4){background:#9b5068 !important;border-color:#9b5068 !important;color:#fff !important}
    html body .mobile-nav__foot .mobile-nav__wedding-cta.is-active:not(#ej689r4):hover,
    html body .mobile-nav__foot .mobile-nav__wedding-cta.is-active:not(#ej689r4):active,
    html body .mobile-nav__foot .mobile-nav__wedding-cta.is-active.is-tapped:not(#ej689r4),
    html body .mobile-nav__foot .mobile-nav__beside-cta.is-active:not(#ej689r4):hover,
    html body .mobile-nav__foot .mobile-nav__beside-cta.is-active:not(#ej689r4):active,
    html body .mobile-nav__foot .mobile-nav__beside-cta.is-active.is-tapped:not(#ej689r4){background:#b46a82 !important;border-color:#b46a82 !important;color:#fff !important}
  </style>
  <script>(function(){document.querySelectorAll('.mobile-nav__wedding-cta,.mobile-nav__beside-cta').forEach(function(a){
    a.addEventListener('touchstart',function(){a.classList.add('is-tapped');},{passive:true});
    ['touchend','touchcancel'].forEach(function(t){a.addEventListener(t,function(){setTimeout(function(){a.classList.remove('is-tapped');},180);},{passive:true});});
  });})();</script>
