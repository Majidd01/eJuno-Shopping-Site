<script>/* #665 header active state follows marketplace tab */(function(){if(location.pathname.indexOf('/pages/vendor-marketplace')<0)return;var map={service:'services',venue:'explore'};function sync(){var a=document.querySelector('[data-vendor-tab].is-active');var t=a?(a.getAttribute('data-vendor-tab')||'').toLowerCase():'all';var want=map[t]?map[t]+'-megamenu':'';document.querySelectorAll('[aria-controls="services-megamenu"],[aria-controls="explore-megamenu"]').forEach(function(el){var on=el.getAttribute('aria-controls')===want;el.classList.toggle('active',on);if(on){el.setAttribute('aria-current','page')}else{el.removeAttribute('aria-current')}var p=el.closest('.nav-item');if(p)p.classList.toggle('is-current',on)})}document.addEventListener('click',function(e){if(e.target.closest&&e.target.closest('[data-vendor-tab]'))setTimeout(sync,0)});function init(){sync();var w=document.querySelector('[data-vendor-tabs]');if(w&&window.MutationObserver)new MutationObserver(sync).observe(w,{subtree:true,attributes:true,attributeFilter:['class']})}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init)}else{init()}})();</script>
<script>/* Trello 670: keep the account dropdown inside the screen. */
(function(){function fit(){document.querySelectorAll('.header-account__menu').forEach(function(m){if(m.hidden||!m.offsetParent)return;var prev=m.style.transform;m.style.transform='';var r=m.getBoundingClientRect(),vw=document.documentElement.clientWidth,pad=8,dx=0;if(r.width>vw-pad*2){m.style.minWidth='0';m.style.width=(vw-pad*2)+'px';r=m.getBoundingClientRect();}if(r.left<pad)dx=pad-r.left;else if(r.right>vw-pad)dx=(vw-pad)-r.right;var nt=dx?'translateX('+Math.round(dx)+'px)':'';m.style.transform=nt;});}
document.addEventListener('click',function(e){if(e.target.closest&&e.target.closest('.header-account')){setTimeout(fit,0);setTimeout(fit,120);}},true);window.addEventListener('resize',fit);
if(window.MutationObserver){var go=function(){document.querySelectorAll('.header-account__menu').forEach(function(m){new MutationObserver(fit).observe(m,{attributes:true,attributeFilter:['hidden','class']});});};if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go);else go();}})();</script>
