.homepage .header.header--home-overlay:has(.nav-item--megamenu.is-open) .logo-tagline,
.homepage .header.header--home-overlay:has(.nav-item--megamenu.is-open) .header-icon,
.homepage .header.header--home-overlay:has(.nav-item--megamenu.is-open) .nav-primary a {
  color: #554c45;
  text-shadow: none;
}
.homepage .header.header--home-overlay:has(.nav-item--megamenu.is-open) .logo b {
  color: var(--berry);
}
.shop-megamenu__item {
  position: relative;
  z-index: 1;
}
.header-megamenu[hidden],
.shop-megamenu[hidden] {
  display: none !important;
}
.shop-megamenu__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6px 20px;
  max-width: 980px;
  margin: 0 auto;
}
.shop-megamenu__grid--4 {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  max-width: 1120px;
}
.shop-megamenu__icon--svg {
  color: var(--berry);
}
.shop-megamenu__icon--svg svg {
  display: block;
}
.shop-megamenu__item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 12px;
  text-decoration: none;
  color: var(--ink);
  transition: background 0.18s ease;
}
.shop-megamenu__item:hover {
  background: var(--soft);
}
.shop-megamenu__icon {
  flex-shrink: 0;
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: rgba(155, 80, 104, 0.1);
}
.shop-megamenu__icon img {
  width: 22px;
  height: 22px;
  object-fit: contain;
  filter: brightness(0) saturate(100%) invert(42%) sepia(22%) saturate(1077%) hue-rotate(295deg) brightness(92%) contrast(89%);
}
.shop-megamenu__copy strong {
  display: block;
  font-family: var(--sans);
  font-size: 15px;
  font-weight: 600;
  line-height: 1.25;
}
.shop-megamenu__copy span {
  display: block;
  margin-top: 4px;
  font-family: var(--sans);
  font-size: 12px;
  line-height: 1.45;
  color: var(--muted);
}
.shop-megamenu__footer {
  max-width: 980px;
  margin: 18px auto 0;
  padding-top: 14px;
  border-top: 1px solid var(--line);
  text-align: center;
  font-size: 13px;
}
.shop-megamenu__footer a {
  color: var(--berry);
  font-weight: 600;
}
.header-actions {
  display: flex;
  align-items: center;
  gap: 2px;
  flex-shrink: 0;
}
.header-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  color: inherit;
  opacity: 0.92;
}
.header-icon:hover {
  opacity: 1;
}
.header-icon--cart,
.header-icon--account,
.header-icon--search {
  position: relative;
  border: 0;
  background: transparent;
  padding: 0;
  cursor: pointer;
  font: inherit;
  color: inherit;
}
.header-account {
  position: relative;
  display: inline-flex;
  align-items: center;
}
.header-account__menu {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  z-index: 400;
  min-width: 220px;
}
.header-account__menu[hidden] {
  display: none !important;
}
.header-account__panel {
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 14px;
  box-shadow: var(--shadow2);
  padding: 8px 0;
  overflow: hidden;
}
.header-account__greeting {
  margin: 0;
  padding: 10px 16px 8px;
  font-family: var(--sans);
  font-size: 12px;
  font-weight: 600;
  color: var(--muted);
  line-height: 1.4;
  border-bottom: 1px solid var(--line);
}
.header-account__item {
  display: block;
  width: 100%;
  padding: 12px 16px;
  border: 0;
  background: transparent;
  text-align: left;
  font-family: var(--sans);
  font-size: 14px;
  font-weight: 600;
  color: var(--ink);
  text-decoration: none;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
