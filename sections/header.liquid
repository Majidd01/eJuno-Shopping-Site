/* Trello 670 #4: above 1280px the nav was absolutely centred with a max-width it could not
   honour (nowrap), so at 1366-1920 "For Vendors" ran into the search icon. Use the same
   logo | nav | actions grid as 1101-1280 so the nav gets its own column and can never
   overlap the icons; spacing/size shrink fluidly instead. */
@media (min-width: 1281px) {
  .ejuno-header .header-inner {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr) minmax(0, auto);
    grid-template-areas: 'logo nav actions';
    align-items: center;
    column-gap: clamp(20px, 2vw, 40px);
  }

  .ejuno-header .header-inner > .logo {
    grid-area: logo;
  }

  .ejuno-header .header-inner > .nav-primary {
    grid-area: nav;
    position: static;
    transform: none;
    max-width: 100%;
    min-width: 0;
    width: 100%;
    gap: clamp(14px, 1.45vw, 28px);
    overflow: visible;
    justify-content: center;
    justify-self: stretch;
  }

  .ejuno-header .header-inner > .ejuno-header-search-slot {
    grid-area: nav;
    justify-self: stretch;
    margin: 0;
    max-width: none;
  }

  .ejuno-header .header-inner > .header-actions {
    grid-area: actions;
    justify-self: end;
    flex-wrap: nowrap;
  }

  .nav-primary a,
  .nav-megamenu-trigger {
    font-size: clamp(14px, 1.08vw, 16px);
  }
}

@media (max-width: 1100px) {
  .header-actions .header-cta--wedding {
    display: none;
  }
}

@media (max-width: 1100px) {
  .nav-primary {
    display: none;
  }
}
@media (max-width: 900px) {
  .shop-megamenu__grid--4 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 900px) {
  .shop-megamenu__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 760px) {
  .header-actions .header-icon:not(.header-icon--cart):not(.header-icon--account):not(.header-icon--search) {
    display: none;
  }
  .header-account__menu {
    right: -8px;
    min-width: min(92vw, 260px);
  }
  .header-cta--wedding {
    font-size: 14px;
    padding: 10px 22px;
  }
}
