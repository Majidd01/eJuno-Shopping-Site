{% stylesheet %}
.ejuno-header .header {
  display: block;
  height: auto;
  min-height: 74px;
  position: sticky;
  top: 0;
  z-index: 80;
}

/* Stick the whole header group so it works on every page (inner sticky fails when the section is only header-tall). */
.shopify-section-group-header-group {
  position: sticky;
  top: 0;
  z-index: 80;
}
.shopify-section-group-header-group .ejuno-header {
  position: relative;
  z-index: 80;
}
.shopify-section-group-header-group .ejuno-header .header:not(.header--home-overlay),
body:not(.homepage) .shopify-section-group-header-group .ejuno-header .header {
  position: relative;
  background: rgba(246, 241, 235, 0.94);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(222, 213, 202, 0.8);
}
.ejuno-header .header-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 74px;
  padding: 11px 0;
  box-sizing: border-box;
  overflow: visible;
}
.header .logo {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  line-height: 1.05;
  position: relative;
  z-index: 3;
  flex-shrink: 0;
}
.header .logo-img {
  display: block;
  line-height: 0;
}
.header .logo-img img {
  display: block;
  height: 34px;
  width: auto;
  max-width: none;
}
@media (max-width: 749px) {
  .header .logo-img img { height: 28px; }
}
.header .logo-lockup {
  display: inline-flex;
  flex-direction: row;
  align-items: flex-start;
  white-space: nowrap;
  font: inherit;
  letter-spacing: inherit;
}
.header .logo-ej,
.header .logo-uno {
  display: inline;
  line-height: 1.05;
  letter-spacing: inherit;
}
.header .logo-ej b,
.header .logo-uno b {
  letter-spacing: inherit;
}
.header .logo-after-j {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}
.header .logo-tagline {
  font-family: var(--sans);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-top: 2px;
  opacity: 0.92;
  white-space: nowrap;
  max-width: none;
}
.ejuno-header .header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  gap: 20px;
  width: min(var(--max), calc(100% - 2 * var(--gutter)));
  max-width: none;
  overflow: visible;
  min-height: 52px;
}
.nav-primary {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-wrap: nowrap;
  justify-content: center;
  align-items: center;
  gap: 24px;
  z-index: 1;
  max-width: min(720px, calc(100% - 520px));
  white-space: nowrap;
  pointer-events: none;
}
.nav-primary > a,
.nav-primary > .nav-item {
  pointer-events: auto;
}
.ejuno-header .header-actions {
  position: relative;
  z-index: 3;
  flex-shrink: 0;
  align-items: center;
}
.nav-primary a,
.nav-megamenu-trigger {
  font-family: var(--sans);
  text-transform: none;
  letter-spacing: 0.01em;
  font-size: 16px;
  color: #554c45;
}
.nav-primary a:hover,
.nav-primary a.active,
.nav-megamenu-trigger.active {
  color: var(--berry);
  font-weight: 600;
}
.nav-item--megamenu.is-current .nav-megamenu-trigger {
  color: var(--berry);
  font-weight: 600;
}
.nav-item--megamenu {
  position: relative;
  display: inline-flex;
  align-items: center;
}
.nav-megamenu-trigger {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
  line-height: 1.2;
  text-decoration: none;
  color: inherit;
}
.nav-megamenu-chevron,
.nav-shop-chevron {
  flex-shrink: 0;
  width: 12px;
  height: 12px;
  margin-top: 2px;
  transition: transform 0.2s ease;
}
.nav-item--megamenu.is-open .nav-megamenu-chevron {
  transform: rotate(180deg);
}
.nav-item--megamenu.is-open .nav-megamenu-trigger,
.nav-item--megamenu:hover .nav-megamenu-trigger {
  color: var(--berry);
}
.header-megamenu,
.shop-megamenu {
  position: fixed;
  left: 0;
  right: 0;
  top: var(--ejuno-megamenu-top, 74px);
  z-index: 320;
  background: var(--paper);
  border-bottom: 1px solid var(--line);
  box-shadow: var(--shadow2);
  padding: 0;
  pointer-events: auto;
}
.header:has(.nav-item--megamenu.is-open) {
