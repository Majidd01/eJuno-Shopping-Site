<section class="section tight">
  <div class="container">
    <div class="plan-map plan-map--open">
      <div class="plan-map__block plan-map__block--phases">
        <header class="plan-map__header">
          <p class="plan-map__kicker">{{ section.settings.phases_kicker }}</p>
          <h2 class="plan-map__title">{{ section.settings.phases_heading }}</h2>
          {% if section.settings.phases_lead != blank %}
            <p class="plan-map__lead">{{ section.settings.phases_lead }}</p>
          {% endif %}
        </header>
        {%- comment -%} Trello 679: the three phases as one line with three points, no boxes. {%- endcomment -%}
        <ol class="ej-journey">
          {% for block in section.blocks %}
            {% if block.type == 'step' %}
              {%- assign ph_label = block.settings.eyebrow | split: '·' | last | strip -%}
              <li class="ej-journey__item" {{ block.shopify_attributes }}>
                <span class="ej-journey__dot" aria-hidden="true"></span>
                <span class="ej-journey__label">{{ ph_label }}</span>
                <h3 class="ej-journey__title">{{ block.settings.title }}</h3>
                <p class="ej-journey__text">{{ block.settings.text }}</p>
              </li>
            {% endif %}
          {% endfor %}
        </ol>
      </div>

      <div class="plan-map__divider" aria-hidden="true"></div>

      <div class="plan-map__block plan-map__block--tools">
        <header class="plan-map__header">
          <p class="plan-map__kicker">{{ section.settings.tools_kicker }}</p>
          <h2 class="plan-map__title">{{ section.settings.tools_heading }}</h2>
          {% if section.settings.tools_lead != blank %}
            <p class="plan-map__lead">{{ section.settings.tools_lead }}</p>
          {% endif %}
        </header>
        {%- comment -%} Trello 679/680: one alternating photo row per tool (photo left, then right), each with its own image. {%- endcomment -%}
        {%- assign ptr_fallbacks = section.settings.tool_fallbacks | default: 'WEB-IMG-001.webp,REG-IMG-001.webp,SEA-IMG-001.webp,HOME-IMG-007.webp,JNL-IMG-003.webp' | split: ',' -%}
        {%- assign ptr_i = 0 -%}
        <div class="ej-tool-rows">
          {% for block in section.blocks %}
            {% if block.type == 'tool' %}
              {%- assign ptr_fb = ptr_fallbacks[ptr_i] | default: 'PLAN-IMG-001.webp' | strip -%}
              {%- assign ptr_mod = ptr_i | modulo: 2 -%}
              <article class="ej-tool-row{% if ptr_mod == 1 %} ej-tool-row--flip{% endif %}" {{ block.shopify_attributes }}>
                <a class="ej-tool-row__media" href="{{ block.settings.url }}" tabindex="-1" aria-hidden="true">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 800, 1200', sizes: '(min-width: 990px) 46vw, 100vw', alt: block.settings.image.alt | default: block.settings.title }}
                  {%- else -%}
                    <img src="{{ ptr_fb | asset_url }}" alt="{{ block.settings.title | escape }}" width="1200" height="900" loading="lazy">
                  {%- endif -%}
                </a>
                <div class="ej-tool-row__copy">
                  {%- if block.settings.eyebrow != blank -%}<p class="ej-tool-row__eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
                  <h3 class="ej-tool-row__name"><a href="{{ block.settings.url }}">{{ block.settings.title }}</a></h3>
                  <p class="ej-tool-row__text">{{ block.settings.text }}</p>
                  <a class="ej-tool-row__link" href="{{ block.settings.url }}">{{ section.settings.tool_link_label | default: 'Open' }} &rarr;</a>
                </div>
              </article>
              {%- assign ptr_i = ptr_i | plus: 1 -%}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

