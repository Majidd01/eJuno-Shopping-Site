<section class="product-head"><div class="container"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1 class="h1">{{ section.settings.heading }}</h1><p class="lead">{{ section.settings.text }}</p></div></section>

{% schema %}
{
  "name": "Guest List hero",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Guest list"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Know Who’s Coming. Know What They Need."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Keep every guest, household and RSVP in one clear list, with dietary needs and travel plans kept separately."
    }
  ],
  "presets": [
    {
      "name": "Guest List hero"
    }
  ]
}
{% endschema %}
