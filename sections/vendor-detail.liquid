<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<script>
// Static fallback images for vendors without businessImages
const staticFallbackImages = [
  'https://cdn.shopify.com/s/files/1/0814/3061/0213/files/pngtree-no-image-vector-illustration-isolated-png-image_1694547.jpg?v=1769511726'
  {% comment %} 'https://images.unsplash.com/photo-1519225421980-715cb0215aed?w=1200&h=800&fit=crop&crop=center',
  'https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?w=1200&h=800&fit=crop&crop=center',
  'https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=1200&h=800&fit=crop&crop=center',
  'https://images.unsplash.com/photo-1469371670807-013ccf25f16a?w=1200&h=800&fit=crop&crop=center',
  'https://images.unsplash.com/photo-1478146896981-b80fe463b330?w=1200&h=800&fit=crop&crop=center',
  'https://images.unsplash.com/photo-1522673607200-164d1b6ce486?w=1200&h=800&fit=crop&crop=center',
  'https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?w=1200&h=800&fit=crop&crop=center',
  'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=1200&h=800&fit=crop&crop=center',
  'https://images.unsplash.com/photo-1522673607200-164d1b6ce486?w=1200&h=800&fit=crop&crop=center',
  'https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?w=1200&h=800&fit=crop&crop=center' {% endcomment %}
];

// Gallery images array - will be populated with vendor business images or fallbacks
let galleryImages = [...staticFallbackImages];

let currentImageIndex = 0;
let isGridView = true;

// Function to update gallery images based on vendor business images
function updateGalleryImages(vendorData) {
  if (vendorData && vendorData.businessImages && vendorData.businessImages.length > 0) {
    // Use vendor's business images
    galleryImages = [...vendorData.businessImages];
    console.log('Using vendor business images:', galleryImages.length);
  } else if (vendorData && vendorData.profilePhoto) {
    // Use profile photo as banner if no business images
    galleryImages = [vendorData.profilePhoto];
    console.log('Using vendor profile photo as banner');
  } else {
    // Use static fallback images as last resort
    galleryImages = [...staticFallbackImages];
    console.log('Using static fallback images');
  }
  
  // Update the main gallery display
  updateMainGalleryDisplay();
  
  // Re-initialize gallery if it's already open
  if (document.getElementById('lightbox').classList.contains('active')) {
    initializeGalleryGrid();
  }
}

// Function to update the main gallery display
function updateMainGalleryDisplay() {
  const mainGallery = document.querySelector('.main-gallery');
  if (!mainGallery) return;
  
  // Clear existing images
  mainGallery.innerHTML = '';
  
  // Check if we're using a single profile image
  const isSingleProfileImage = galleryImages.length === 1;
  
  // Add or remove the single-profile-image class
  if (isSingleProfileImage) {
    mainGallery.classList.add('single-profile-image');
  } else {
    mainGallery.classList.remove('single-profile-image');
  }
  
  // Add images to main gallery (first 5 images)
  const imagesToShow = galleryImages.slice(0, 5);
  const totalImages = galleryImages.length;
  const remainingImages = totalImages - 5;
  
  imagesToShow.forEach((image, index) => {
    const galleryItem = document.createElement('div');
    galleryItem.className = 'gallery-item';
    
    // Add main-image class to first item
    if (index === 0) {
      galleryItem.classList.add('main-image');
    }
    
    // Don't make single profile image clickable for gallery
    if (!isSingleProfileImage) {
      galleryItem.onclick = () => openGalleryGrid();
    }
    
    const img = document.createElement('img');
    img.src = image;
    img.alt = `Gallery Image ${index + 1}`;
    img.loading = 'lazy';
    
    // Add error handling for failed image loads
    img.onerror = function() {
      console.warn(`Failed to load main gallery image: ${image}`);
      this.src = staticFallbackImages[index % staticFallbackImages.length];
    };
    
    galleryItem.appendChild(img);
    
    // Add overlay to the last image if there are more images (only for multi-image galleries)
    if (index === 4 && remainingImages > 0 && !isSingleProfileImage) {
      const overlay = document.createElement('div');
      overlay.className = 'permanent-overlay';
      overlay.innerHTML = `
        <div>
          <div style="font-size: 24px; font-weight: 700;">+${remainingImages}</div>
          <div style="font-size: 14px; margin-top: 5px;">more photos</div>
        </div>
      `;
      galleryItem.appendChild(overlay);
    }
    
    mainGallery.appendChild(galleryItem);
  });
}

// Initialize gallery grid
function initializeGalleryGrid() {
  const galleryGrid = document.getElementById('gallery-grid');
  galleryGrid.innerHTML = '';
  
  galleryImages.forEach((image, index) => {
    const gridItem = document.createElement('div');
    gridItem.className = 'grid-item';
    gridItem.onclick = () => openSingleImage(index);
    
    const img = document.createElement('img');
    img.src = image;
    img.alt = `Wedding Venue ${index + 1}`;
    
    // Add error handling for failed image loads
    img.onerror = function() {
      console.warn(`Failed to load image: ${image}`);
      // Use a fallback image if the vendor image fails to load
      this.src = staticFallbackImages[index % staticFallbackImages.length];
    };
    
    gridItem.appendChild(img);
    galleryGrid.appendChild(gridItem);
  });
}

// Open gallery grid view
function openGalleryGrid() {
  const lightbox = document.getElementById('lightbox');
  const galleryGrid = document.getElementById('gallery-grid');
  const singleImageView = document.getElementById('single-image-view');
  const backToGrid = document.getElementById('back-to-grid');
  const imageCounter = document.getElementById('image-counter');
  
  // Show lightbox
  lightbox.classList.add('active');
  document.body.style.overflow = 'hidden';
  
  // Show grid view, hide single image view
  galleryGrid.classList.add('active');
  singleImageView.style.display = 'none';
  backToGrid.style.display = 'none';
  imageCounter.style.display = 'none';
  
  isGridView = true;
  initializeGalleryGrid();
}

// Open single image view
function openSingleImage(index) {
  currentImageIndex = index;
  const galleryGrid = document.getElementById('gallery-grid');
  const singleImageView = document.getElementById('single-image-view');
  const lightboxImage = document.getElementById('lightbox-image');
  const backToGrid = document.getElementById('back-to-grid');
  const imageCounter = document.getElementById('image-counter');
  
  // Hide grid view, show single image view
  galleryGrid.classList.remove('active');
  singleImageView.style.display = 'block';
  backToGrid.style.display = 'block';
  imageCounter.style.display = 'block';
  
  // Set image and counter
  lightboxImage.src = galleryImages[index];
  imageCounter.textContent = `${index + 1} / ${galleryImages.length}`;
  
  isGridView = false;
}

// Show gallery grid from single image view
function showGalleryGrid() {
  const galleryGrid = document.getElementById('gallery-grid');
  const singleImageView = document.getElementById('single-image-view');
  const backToGrid = document.getElementById('back-to-grid');
  const imageCounter = document.getElementById('image-counter');
  
  // Show grid view, hide single image view
  galleryGrid.classList.add('active');
  singleImageView.style.display = 'none';
  backToGrid.style.display = 'none';
  imageCounter.style.display = 'none';
  
  isGridView = true;
}

// Close lightbox
function closeLightbox(event) {
  if (event && event.target !== event.currentTarget) return;
  const lightbox = document.getElementById('lightbox');
  lightbox.classList.remove('active');
  document.body.style.overflow = 'auto';
}

// Change image in single view
function changeImage(direction) {
  if (isGridView) return;
  
  currentImageIndex += direction;
  if (currentImageIndex < 0) currentImageIndex = galleryImages.length - 1;
  if (currentImageIndex >= galleryImages.length) currentImageIndex = 0;
  
  const lightboxImage = document.getElementById('lightbox-image');
  const imageCounter = document.getElementById('image-counter');
  
  lightboxImage.src = galleryImages[currentImageIndex];
  imageCounter.textContent = `${currentImageIndex + 1} / ${galleryImages.length}`;
}

// Keyboard navigation for lightbox
document.addEventListener('keydown', function(e) {
  if (document.getElementById('lightbox').classList.contains('active')) {
    if (e.key === 'Escape') {
      if (!isGridView) {
        showGalleryGrid();
      } else {
        closeLightbox();
      }
    }
    if (!isGridView) {
      if (e.key === 'ArrowLeft') changeImage(-1);
      if (e.key === 'ArrowRight') changeImage(1);
    }
  }
});

document.addEventListener("DOMContentLoaded", function () {
  const params = new URLSearchParams(window.location.search);
  const vendorId = params.get("id");
  if (!vendorId) return;

  const backendAPI = 'https://ejuno-dev.skylinxtech.co/api';

  function hidePageLoader() {
    const wrapper = document.getElementById('vendor-detail-wrapper');
    if (wrapper) wrapper.classList.remove('vd-loading');
  }

  let vendorLoaded = false, productsLoaded = false;
  function checkAllLoaded() {
    if (vendorLoaded && productsLoaded) hidePageLoader();
  }

  // Fetch Vendor Info
  fetch(`${backendAPI}/vendors/${vendorId}`)
    .then(res => res.json())
    .then(({ data }) => {
      if (!data) return;

      console.log('Vendor data loaded:', data);
      console.log('Business images:', data.businessImages);

      // Update gallery images based on vendor business images
      updateGalleryImages(data);

      const profileImg = data.profilePhoto || 'https://cdn.shopify.com/s/files/1/0814/3061/0213/files/default-user.png';
      const card = `
        <div style="text-align: center;display:flex;justify-content:center;">
          <img src="${profileImg}" alt="Profile Photo" class="vendor-card-profile-photo" />
        </div>
        <h2>${data.companyName}</h2>
        <p><strong>🏙️ City:</strong> ${data.city}</p>
        <p><strong>🌍 Country:</strong> ${data.country}</p>

        {% comment %} <p><strong>📧 Email:</strong> ${data.email}</p>
        <p><strong>📞 Phone:</strong> ${data.phone}</p>
        
        <p><strong>🌐 Website:</strong> <a href="${data.companyWebsite}" target="_blank">${data.companyWebsite}</a></p>
        <div class="social-links">
          ${data.facebook ? `<a href="${data.facebook}" target="_blank" style="background:#3b5998;color:white;"><i class="fab fa-facebook-f"></i></a>` : ''}
          ${data.instagram ? `<a href="${data.instagram}" target="_blank" style="background:#e4405f;color:white;"><i class="fab fa-instagram"></i></a>` : ''}
          ${data.tiktok ? `<a href="${data.tiktok}" target="_blank" style="background:#000;color:white;"><i class="fab fa-tiktok"></i></a>` : ''}
          ${data.youtube ? `<a href="${data.youtube}" target="_blank" style="background:#ff0000;color:white;"><i class="fab fa-youtube"></i></a>` : ''}
        </div> {% endcomment %}
      `;
      document.getElementById("vendor-card").innerHTML = card;
      vendorLoaded = true;
      checkAllLoaded();

      // ── Render Reviews from coupleRatings ──
      const reviewsSection = document.getElementById("vendor-reviews");
      const ratings = data.coupleRatings || [];
      const stats = data.overallRatingStats;

      if (ratings.length === 0) {
        reviewsSection.innerHTML = '<p style="color: #666; text-align: center; font-style: italic;">No ratings and reviews yet.</p>';
        // Hide heading if no reviews
        const reviewsHeading = document.querySelector('#vendor-reviews-section h2');
        if (reviewsHeading) reviewsHeading.style.display = 'none';
      } else {
        // Summary bar
        let summaryHTML = '';
        if (stats) {
          const avg = stats.averageOverallExperience || 0;
          const total = stats.totalRatings || 0;
          const fullStars = Math.round(avg);
          summaryHTML = `
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:24px;padding-bottom:16px;border-bottom:1px solid #e2e8f0;flex-wrap:wrap;">
              <span style="color:#FFD700;font-size:22px;">${'★'.repeat(fullStars)}${'☆'.repeat(5 - fullStars)}</span>
              <strong style="font-size:18px;color:#2d3748;">${avg.toFixed(1)}</strong>
              <span style="color:#718096;font-size:14px;">(${total} review${total !== 1 ? 's' : ''})</span>
            </div>
          `;
        }

        const REVIEW_LIMIT = 3;
        const reviewCards = ratings.map((r, idx) => {
          const name = r.couple ? `${r.couple.firstName || ''} ${r.couple.lastName || ''}`.trim() : 'Anonymous';
          const overall = r.ratings?.overallExperience || 0;
          const comment = r.comment || '';
          const adminComment = r.adminComment || '';
          const tags = (r.tags || []).map(t => `<span style="display:inline-block;background:#fef0f6;color:#c2185b;padding:3px 10px;border-radius:12px;font-size:12px;font-weight:600;">${t}</span>`).join(' ');
          const date = r.reviewedAt ? new Date(r.reviewedAt).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) : '';
          const hiddenStyle = idx >= REVIEW_LIMIT ? 'display:none;' : '';
          const adminCommentHtml = adminComment ? `<div style="margin-top:12px;padding:12px;background:#f8f5ff;border-left:4px solid #8c368c;border-radius:0 8px 8px 0;"><div style="font-size:15px;font-weight:600;color:#8c368c;margin-bottom:4px;">eJuno</div><div style="font-size:17px;color:#444;line-height:1.5;">${adminComment}</div></div>` : '';
          return `
            <div class="vendor-review-item" data-review-idx="${idx}" style="${hiddenStyle}border-bottom:1px solid #e2e8f0;padding-bottom:20px;margin-bottom:20px;">
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap;">
                <strong style="color:#2d3748;font-size:15px;">${name}</strong>
                <span style="color:#FFD700;font-size:16px;">${'★'.repeat(Math.round(overall))}${'☆'.repeat(5 - Math.round(overall))}</span>
                ${date ? `<span style="color:#a0aec0;font-size:12px;margin-left:auto;">${date}</span>` : ''}
              </div>
              ${comment ? `<p style="color:#4a5568;line-height:1.6;margin:0 0 8px 0;font-size:14px;">${comment}</p>` : ''}
              ${tags ? `<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px;">${tags}</div>` : ''}
              ${adminCommentHtml}
            </div>
          `;
        }).join('');

        const showMoreBtn = ratings.length > REVIEW_LIMIT
          ? `<button type="button" id="reviews-show-more" onclick="toggleVendorReviews()">Show More (${ratings.length - REVIEW_LIMIT} more)</button>`
          : '';

        reviewsSection.innerHTML = summaryHTML + reviewCards + showMoreBtn;
      }
    })
    .catch(error => {
      console.error('Error fetching vendor data:', error);
      updateGalleryImages(null);
      vendorLoaded = true;
      checkAllLoaded();
    });

  // Fetch Products and Reviews
  fetch(`${backendAPI}/vendors/${vendorId}/products`)
    .then(res => res.json())
    .then(({ data }) => {
      const slider = document.getElementById("vendor-products-slider");
      if (!data || !Array.isArray(data)) { document.querySelector(".slider-nav-container").style.display = 'none'; productsLoaded = true; checkAllLoaded(); return; }

      const activeProducts = data.filter(p => p.status === 'active').slice(0, 8);

      if (activeProducts.length === 0) {
        slider.innerHTML = `<div class="no-products-msg">No active products yet.</div>`;
        document.querySelector(".slider-nav-container").style.display = 'none';
        productsLoaded = true; checkAllLoaded();
        return;
      }

      activeProducts.forEach(product => {
        const image = product.images?.[0]?.src || "https://cdn.shopify.com/s/files/1/0814/3061/0213/files/61889128724be9b53a7d9893de2e8d0c_07aeaf89-fc48-4f2d-bb73-8fc7fd1eb50d";
        const packages = product.productPackages || [];

        const productCard = document.createElement("div");
        productCard.className = "product-card";
        productCard.style.width = "350px";
        productCard.style.padding = "20px";
        productCard.style.flex = "0 0 auto";

       const shortDesc = truncateHTML(product.body_html, 120);
       const priceHtml =
         window.EjunoCardPrice && typeof window.EjunoCardPrice.htmlForProduct === 'function'
           ? window.EjunoCardPrice.htmlForProduct(product)
           : '';

productCard.innerHTML = `
  <img src="${image}" alt="${product.title}"
    style="width: 100%; height: 250px; object-fit: cover; border-radius: 15px; margin-bottom: 15px;" />

  <h3 style="margin: 10px 0; color: #2d3748; font-weight: 600;">
    ${product.title}
  </h3>

  <p style="font-size: 14px; color: #666; line-height: 1.5;">
    ${shortDesc}
  </p>

  ${priceHtml}

  <div style="margin-top: 15px;">
    ${
      ['service', 'venue'].includes((product.type || '').toLowerCase())
        ? `<a href="/products/${product.handle}" class="product-btn"
            style="color:#fff;padding:12px 20px;border-radius:15px;text-decoration:none;display:inline-block;font-weight:600;font-size:14px;">
            Book Now
          </a>`
        : `<a href="/products/${product.handle}" class="product-btn"
            style="color:#fff;padding:12px 20px;border-radius:15px;text-decoration:none;display:inline-block;font-weight:600;font-size:14px;">
            Add to Cart
          </a>`
    }
  </div>
`;
        slider.appendChild(productCard);
      });

      // Show/hide navigation arrows based on product count
      const sliderPrev = document.getElementById("slider-prev");
      const sliderNext = document.getElementById("slider-next");
      const sliderNavContainer = document.querySelector(".slider-nav-container");
      
      if (activeProducts.length <= 2) {
        // Hide navigation arrows if 2 or fewer products
        sliderNavContainer.style.display = 'none';
      } else {
        // Show navigation arrows if more than 2 products
        sliderNavContainer.style.display = 'flex';
        
        // Prev/Next scroll
        const scrollAmount = 300;
        sliderPrev.onclick = () => {
          slider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        };
        sliderNext.onclick = () => {
          slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        };
      }

      productsLoaded = true;
      checkAllLoaded();
    })
    .catch(error => {
      console.error('Error fetching products:', error);
      productsLoaded = true;
      checkAllLoaded();
    });
});
</script>
<script>
  function truncateHTML(html, limit = 120) {
    if (!html) return '';
    const text = html.replace(/<[^>]*>/g, ''); // remove HTML tags
    return text.length > limit ? text.substring(0, limit) + '...' : text;
  }

  let vendorReviewsExpanded = false;
  function toggleVendorReviews() {
    vendorReviewsExpanded = !vendorReviewsExpanded;
    const items = document.querySelectorAll('.vendor-review-item');
    items.forEach((item, idx) => {
      if (idx >= 3) {
        item.style.display = vendorReviewsExpanded ? '' : 'none';
      }
    });
    const btn = document.getElementById('reviews-show-more');
    if (btn) {
      const hiddenCount = items.length - 3;
      btn.textContent = vendorReviewsExpanded ? 'Show Less' : `Show More (${hiddenCount} more)`;
    }
  }
</script>
