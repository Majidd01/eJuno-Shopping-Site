<style>
  #vendor-detail-wrapper,
  #vendor-detail-wrapper * {
    box-sizing: border-box;
  }

  #vendor-detail-wrapper {
    background: #ffffff;
    min-height: 50vh;
    padding: 16px max(var(--gutter, 18px), 16px) 48px;
    overflow-x: hidden;
    max-width: 100%;
    line-height: 1.6;
  }

  /* Image Gallery Styles */
  .gallery-section {
    position: relative;
    margin: 20px auto 40px auto;
    max-width: 1400px;
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);

  }

  .main-gallery {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 300px 200px;
    gap: 10px;

    height: auto;
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: 15px;
    cursor: pointer;
    transition: all 0.3s ease;
    background: #f8f9fa;
  }

  .gallery-item:hover {
    transform: scale(1.02);
    box-shadow: 0 8px 25px rgba(0,0,0,0.15);
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.1);
  }

  .main-image {
    grid-row: 1 / 3;
  }

  /* Single profile image layout - full width */
  .main-gallery.single-profile-image {
    display: block;
  }

  .main-gallery.single-profile-image .gallery-item {
    width: 100%;
    height: 400px;
    border-radius: 20px;
  }

  .main-gallery.single-profile-image .gallery-item img {
    width: auto;
    height: 100%;
    object-fit: cover;
  }

  .view-all-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 18px;
    font-weight: 600;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .gallery-item:hover .view-all-overlay {
    opacity: 1;
  }

  .permanent-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    text-align: center;
    opacity: 1;
  }

  .gallery-counter {
    position: absolute;
    bottom: 15px;
    right: 15px;
    background: rgba(0,0,0,0.8);
    color: white;
    padding: 8px 15px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 500;
  }

  /* Lightbox Styles */
  .lightbox {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.9);
    z-index: 1000;
    justify-content: center;
    align-items: center;
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox-content {
    max-width: 90%;
    max-height: 90%;
    position: relative;
  }

  .lightbox img {
    width: 100%;
    height: auto;
    border-radius: 10px;
  }

  .lightbox-close {
    position: absolute;
    top: 40px;
    right: 0;
    color: white;
    font-size: 30px;
    cursor: pointer;
    background: rgba(255,255,255,0.2);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease;
  }

  .lightbox-close:hover {
    background: rgba(255,255,255,0.3);
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.2);
    color: white;
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 20px;
    transition: background 0.3s ease;
  }

  .lightbox-nav:hover {
    background: rgba(255,255,255,0.3);
  }

  .lightbox-prev {
    left: -60px;
  }

  .lightbox-next {
    right: -60px;
  }

  /* Gallery Grid View */
  .gallery-grid {
    display: none;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(3, 200px);
    gap: 12px;
    max-height: 80vh;
    overflow-y: auto;
    padding: 20px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .gallery-grid.active {
    display: grid;
  }

  .grid-item {
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
  }

  .grid-item:hover {
    transform: scale(1.02);
    box-shadow: 0 8px 25px rgba(0,0,0,0.3);
    z-index: 2;
  }

  .grid-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Specific grid item sizes for variety */
  .grid-item:nth-child(1) {
    grid-column: span 2;
    grid-row: span 2;
  }

  .grid-item:nth-child(2) {
    grid-column: span 1;
    grid-row: span 1;
  }

  .grid-item:nth-child(3) {
    grid-column: span 1;
    grid-row: span 1;
  }

  .grid-item:nth-child(4) {
    grid-column: span 2;
    grid-row: span 1;
  }

  .grid-item:nth-child(5) {
    grid-column: span 1;
    grid-row: span 1;
  }

  .grid-item:nth-child(6) {
    grid-column: span 1;
    grid-row: span 1;
  }

  .grid-item:nth-child(7) {
    grid-column: span 1;
    grid-row: span 1;
  }

  .grid-item:nth-child(8) {
    grid-column: span 1;
    grid-row: span 1;
  }

  .grid-item:nth-child(9) {
    grid-column: span 2;
    grid-row: span 1;
  }

  .grid-item:nth-child(10) {
    grid-column: span 2;
    grid-row: span 1;
  }

  .lightbox-header {
    position: absolute;
    top: 20px;
    left: 20px;
    right: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 10;
  }

  .back-to-grid {
    background: rgba(255,255,255,0.2);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 25px;
    cursor: pointer;
    font-size: 14px;
    transition: background 0.3s ease;
  }

  .back-to-grid:hover {
    background: rgba(255,255,255,0.3);
  }

  .image-counter {
    background: rgba(0,0,0,0.6);
    color: white;
    padding: 8px 15px;
    border-radius: 20px;
    font-size: 14px;
  }

  /* Content Container */
  .content-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
    align-items: flex-start;
    width: 100%;
    padding: 0 4px;
  }

  /* Hide scrollbar */
  #vendor-products-slider {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  #vendor-products-slider::-webkit-scrollbar {
    display: none;
  }

  .slider-nav-container {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .slider-nav-button {
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--line, #ded5ca);
    background: rgba(255, 255, 255, 0.95);
    color: var(--berry, #9b5068);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.6);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .slider-nav-button svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  .slider-nav-button:hover {
    background: var(--berry, #9b5068);
    border-color: var(--berry, #9b5068);
    color: #fff;
    transform: translateY(-1px);
  }

  .slider-nav-button:active {
    transform: translateY(0);
  }

  .slider-nav-button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none;
  }

  .no-products-msg {
    background: #fff;
    padding: 30px;
    border-radius: 20px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    font-size: 16px;
    color: #666;
    text-align: center;
    width: 100%;
  }

  /* Vendor Card Styles */
  #vendor-card {
    width: 100%;
    max-width: 360px;
    flex: 1 1 280px;
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    padding: 30px;
    border: 1px solid #e2e8f0;
    height: fit-content;
    margin-bottom: 30px;
  }

  #vendor-card .vendor-card-profile-photo {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 20px;
    display: block;
    border: 3px solid rgba(155, 80, 104, 0.35);
  }

  #vendor-card h2 {
    font-size: clamp(24px, 4vw, 28px);
    color: var(--ink, #2d3748);
    text-align: center;
    margin-bottom: 20px;
    font-family: var(--serif, Georgia, serif);
    font-weight: 400;
  }

  #vendor-card p {
    font-size: 14px;
    color: #4a5568;
    margin: 10px 0;
    display: flex;
    align-items: center;
    gap: 10px;
    display:flex;
    flex-wrap:wrap;
  }

  #vendor-card p strong {
    color: #2d3748;
    min-width: 80px;
  }

  #vendor-card a {
    text-decoration: none;
    font-weight: 600;
    color: var(--berry, #9b5068);
    transition: color 0.3s ease;
  }

  #vendor-card a:hover {
    color: var(--berry-dark, #7e3d55);
    text-decoration: underline;
  }

  .social-links {
    margin-top: 25px;
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .social-links a {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    transition: all 0.3s ease;
    box-shadow: 0 3px 10px rgba(0,0,0,0.1);
  }

  .social-links a:hover {
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
  }

  /* Products Section */
  .products-section {
    flex: 1 1 320px;
    min-width: 0;
    width: 100%;
  }

  #vendor-reviews-section {
    background: #ffffff;
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    border: 1px solid #e2e8f0;
    margin-bottom: 40px;
  }

  #vendor-reviews-section h2 {
    font-size: 24px;
    color: #2d3748;
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 15px;
    margin-bottom: 25px;
    font-weight: 700;
  }

  /* FAQ Section (V5 accordion — shared with ejuno-faq.css) */
  .faq-section.ejuno-faq {
    max-width: 1200px;
    margin: 40px auto;
    padding: 36px 40px 40px;
    background: var(--paper, #fff);
    border: 1px solid var(--line, #e8dfd4);
    border-radius: 24px;
    box-shadow: var(--shadow2, 0 12px 40px rgba(45, 35, 32, 0.06));
  }

  .ejuno-vendor-faq__title {
    margin: 0 0 8px;
    font-family: var(--serif, Georgia, serif);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 400;
    text-align: center;
    color: var(--ink, #2d2320);
  }

  /* Product Card Improvements */
  .product-card {
    background: #ffffff !important;
    border-radius: 20px !important;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08) !important;
    border: 1px solid #e2e8f0 !important;
    transition: all 0.3s ease !important;
  }

  .product-card:hover {
    transform: translateY(-5px) !important;
    box-shadow: 0 15px 40px rgba(0,0,0,0.15) !important;
  }

  .product-btn {
    background: var(--berry, #9b5068) !important;
    border-radius: 999px !important;
    transition: background 0.2s ease, transform 0.2s ease !important;
  }

  .product-btn:hover {
    background: var(--berry-dark, #7e3d55) !important;
    transform: translateY(-1px) !important;
    box-shadow: none !important;
  }

  #reviews-show-more {
    display: block;
    margin: 16px auto 0;
    background: transparent;
    color: var(--ink, #201c19);
    border: 1px solid var(--line, rgba(32, 28, 25, 0.14));
    border-radius: 999px;
    padding: 11px 26px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }

  #reviews-show-more:hover {
    border-color: var(--berry, #9b5068);
    color: var(--berry, #9b5068);
    background: rgba(155, 80, 104, 0.06);
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .main-gallery {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 250px 200px 200px;
      height: auto;
    }

    .main-image {
      grid-row: 1 / 2;
      grid-column: 1 / 3;
    }

    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(4, 180px);
      max-width: 800px;
    }

    .grid-item:nth-child(1) {
      grid-column: span 2;
      grid-row: span 2;
    }

    .grid-item:nth-child(4) {
      grid-column: span 2;
      grid-row: span 1;
    }

    .grid-item:nth-child(9) {
      grid-column: span 3;
      grid-row: span 1;
    }

    .grid-item:nth-child(10) {
      grid-column: span 3;
      grid-row: span 1;
    }
  }

  @media (max-width: 768px) {
    #vendor-detail-wrapper {
      padding: 12px var(--gutter, 18px) 40px;
    }

    .gallery-section {
      margin: 0 0 24px;
      border-radius: 16px;
    }

    .content-container {
      flex-direction: column;
      padding: 0;
      gap: 24px;
    }

    #vendor-card {
      flex: none;
      width: 100%;
      max-width: none;
      padding: 22px 18px;
      margin-bottom: 0;
    }

    #vendor-card h2 {
      font-size: clamp(22px, 5.5vw, 28px);
    }

    .main-gallery {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 10px;
      padding: 12px;
      grid-template-columns: unset;
      grid-template-rows: unset;
    }

    .main-gallery .gallery-item {
      flex: 0 0 min(88vw, 420px);
      min-height: 240px;
      scroll-snap-align: start;
    }

    .main-gallery.single-profile-image {
      display: block;
      padding: 12px;
      overflow: visible;
    }

    .main-gallery.single-profile-image .gallery-item {
      width: 100%;
      height: min(300px, 52vw);
    }

    .main-image {
      grid-row: auto;
      grid-column: auto;
    }

    .products-section {
      min-width: 0;
    }

    .slider-nav-container {
      gap: 8px;
      margin-bottom: 12px;
    }

    #vendor-products-slider {
      margin-left: calc(-1 * var(--gutter, 18px));
      margin-right: calc(-1 * var(--gutter, 18px));
      padding-left: var(--gutter, 18px) !important;
      padding-right: var(--gutter, 18px) !important;
      scroll-snap-type: x mandatory;
    }

    #vendor-products-slider .product-card {
      scroll-snap-align: start;
      flex: 0 0 min(280px, 82vw) !important;
    }

    #vendor-reviews-section {
      padding: 22px 18px;
    }

    .faq-section {
      padding: 24px 18px;
      margin: 24px 0 32px;
      border-radius: 16px;
    }

    .ejuno-vendor-faq__title {
      font-size: clamp(24px, 5.5vw, 28px);
      margin-bottom: 20px;
    }

    .faq-section.ejuno-faq .faq-q {
      font-size: 15px;
    }

    .lightbox-nav {
      display: flex;
      width: 44px;
      height: 44px;
      font-size: 18px;
    }

    .lightbox-prev {
      left: 8px;
    }

    .lightbox-next {
      right: 8px;
    }

    .lightbox-header {
      top: 12px;
      left: 12px;
      right: 12px;
    }

    .lightbox-content {
      max-width: 100%;
      width: 100%;
      padding: 0 12px;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(5, 150px);
      gap: 10px;
      padding: 15px;
      max-width: 100%;
    }

    .grid-item:nth-child(1) {
      grid-column: span 2;
      grid-row: span 2;
    }

    .grid-item:nth-child(4) {
      grid-column: span 2;
      grid-row: span 1;
    }

    .grid-item:nth-child(9) {
      grid-column: span 2;
      grid-row: span 1;
    }

    .grid-item:nth-child(10) {
      grid-column: span 2;
      grid-row: span 1;
    }
  }

  @media (max-width: 480px) {
    .main-gallery {
      padding: 10px;
    }

    #vendor-card {
      padding: 25px;
    }

    .faq-section {
      padding: 20px 15px;
      margin: 20px 10px 40px 10px;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(10, 200px);
      gap: 8px;
      padding: 10px;
    }

    .grid-item:nth-child(n) {
      grid-column: span 1;
      grid-row: span 1;
    }

    .grid-item:nth-child(1) {
      grid-row: span 2;
    }
  }
  /* Full-page loader */
  .vd-fullpage-loader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(255,255,255,0.92);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    transition: opacity 0.4s ease;
  }
  .vd-fullpage-loader.fade-out {
    opacity: 0;
    pointer-events: none;
  }
  .vd-fullpage-loader .vd-spinner {
    width: 60px;
    height: 60px;
    border: 5px solid #f0f0f5;
    border-radius: 50%;
    border-top-color: var(--berry, #9b5068);
    animation: vd-spin 0.8s linear infinite;
  }
  @keyframes vd-spin {
    to { transform: rotate(360deg); }
  }
</style>



<div id="vendor-detail-wrapper" class="vd-loading">
  <div class="vd-skeleton-page" id="vdPageLoader" aria-live="polite">
    {% render 'ejuno-skeleton-vendor-detail' %}
  </div>
  <div class="vd-live-content">
  <!-- Image Gallery Section -->
  <div class="gallery-section">
    <div class="main-gallery">
      <div class="gallery-item main-image" onclick="openGalleryGrid()">
        <img
          src="https://images.unsplash.com/photo-1519225421980-715cb0215aed?w=800&h=600&fit=crop&crop=center"
          alt="Wedding Venue 1"
        >
      </div>
      <div class="gallery-item" onclick="openGalleryGrid()">
        <img
          src="https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?w=400&h=300&fit=crop&crop=center"
          alt="Wedding Venue 2"
        >
      </div>
      <div class="gallery-item" onclick="openGalleryGrid()">
        <img
          src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=400&h=300&fit=crop&crop=center"
          alt="Wedding Venue 3"
        >
      </div>
      <div class="gallery-item" onclick="openGalleryGrid()">
        <img
          src="https://images.unsplash.com/photo-1469371670807-013ccf25f16a?w=400&h=300&fit=crop&crop=center"
          alt="Wedding Venue 4"
        >
      </div>
      <div class="gallery-item" onclick="openGalleryGrid()">
        <img
          src="https://images.unsplash.com/photo-1478146896981-b80fe463b330?w=400&h=300&fit=crop&crop=center"
          alt="Wedding Venue 5"
        >
        <div class="permanent-overlay">
          <div>
            <div style="font-size: 24px; font-weight: 700;">+5</div>
            <div style="font-size: 14px; margin-top: 5px;">more photos</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" onclick="closeLightbox(event)">
    <div class="lightbox-header">
      <button class="back-to-grid" id="back-to-grid" onclick="showGalleryGrid()" style="display: none;">
        ← Back to Gallery
      </button>
      <div class="image-counter" id="image-counter" style="display: none;">1 / 10</div>
      <span class="lightbox-close" onclick="closeLightbox()">&times;</span>
    </div>

    <div class="lightbox-content">
      <!-- Gallery Grid View -->
      <div class="gallery-grid" id="gallery-grid">
        <!-- Grid items will be populated by JavaScript -->
      </div>

      <!-- Single Image View -->
      <div id="single-image-view" style="display: none; position: relative;">
        <button class="lightbox-nav lightbox-prev" onclick="changeImage(-1)">&#8249;</button>
        <img id="lightbox-image" src="" alt="Gallery Image">
        <button class="lightbox-nav lightbox-next" onclick="changeImage(1)">&#8250;</button>
      </div>
    </div>
  </div>

  <div class="content-container">
    <!-- Vendor Card -->
    <div id="vendor-card"></div>

    <!-- Products Section -->
    <div class="products-section">
      <div class="slider-nav-container">
        <button type="button" id="slider-prev" class="slider-nav-button" aria-label="Previous listing">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
