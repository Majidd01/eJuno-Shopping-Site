<section class="section tight"><div class="container"><div class="dashboard"><div class="dash-head"><strong>Guest List</strong><a class="btn primary" href="https://ejuno-staging.web.app/couple-dashboard">Open Guest List</a></div><div class="dash-grid"><div class="dash-side"><div class="active">All Guests</div><div>Households</div><div>RSVP Status</div><div>Dietary Notes</div><div>Travel Notes</div></div><div class="dash-main"><div class="kpis"><div class="kpi"><strong>124</strong><span>Invited</span></div><div class="kpi"><strong>87</strong><span>Attending</span></div><div class="kpi"><strong>29</strong><span>Pending</span></div><div class="kpi"><strong>8</strong><span>Declined</span></div></div><style>@media (max-width:760px){.dashboard .table-scroll .table tbody tr:not(:first-child) td:nth-child(4):before{content:"Dietary"}.dashboard .table-scroll .table tbody tr:not(:first-child) td:nth-child(5):before{content:"Travel"}}</style><div class="table-scroll"><table class="table"><tr><th>Guest / Household</th><th>Guests</th><th>RSVP</th><th>Dietary</th><th>Travel</th></tr><tr><td>Rossi Household</td><td>2</td><td><span class="status">Attending</span></td><td>Vegetarian</td><td>—</td></tr><tr><td>Kapoor Family</td><td>4</td><td><span class="status status--pending">Pending</span></td><td>—</td><td>Airport transfer</td></tr><tr><td>Fischer +1</td><td>2</td><td><span class="status">Attending</span></td><td>—</td><td>—</td></tr><tr><td>Moretti Household</td><td>3</td><td><span class="status status--pending">Pending</span></td><td>Children's menu</td><td>—</td></tr></table></div></div></div></div></div></section><section class="section tight"><div class="container plan-editorial"><img src="{{ 'GST-IMG-001.webp' | asset_url }}" width="1672" height="941" loading="lazy" style="height:390px"><div><div class="eyebrow">Why this matters</div><h2 class="h2">The guest list feeds the rest of the day</h2><p class="lead">Seating and communication depend on knowing who is coming. Dietary needs go to your caterer and travel plans to whoever arranges transfers and stays, so each has its own column. Keeping it all in one place makes every next decision easier.</p></div></div></section>

{% schema %}
{
  "name": "Guest List content",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "editor_note",
      "label": "Editor note",
      "default": "Content below keeps the approved prototype structure."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Content item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Item"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Content item"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Add supporting content."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Guest List content"
    }
  ]
}
{% endschema %}
