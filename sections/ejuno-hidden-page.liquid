{% comment %}
  Hidden page stub — redirects away from unpublished/hidden marketing pages.
{% endcomment %}
{% liquid
  assign dest = section.settings.redirect_url | default: '/pages/plan-your-wedding'
  if dest == blank
    assign dest = routes.root_url
  endif
%}
<script>
  window.location.replace({{ dest | json }});
</script>
<meta http-equiv="refresh" content="0;url={{ dest }}">
<section class="section tight">
  <div class="container" style="padding:48px 0;text-align:center">
    <p style="color:var(--muted);margin:0 0 16px">This page is no longer available.</p>
    <a class="btn primary" href="{{ dest }}">Continue</a>
  </div>
</section>

{% schema %}
{
  "name": "Hidden page redirect",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "url",
      "id": "redirect_url",
      "label": "Redirect to"
    }
  ],
  "presets": [
    {
      "name": "Hidden page redirect"
    }
  ]
}
{% endschema %}
