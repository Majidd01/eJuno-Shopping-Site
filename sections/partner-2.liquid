<section class="section partner-benefits">
  <div class="container">
    <div class="section-head partner-section-head">
      <div class="copy">
        <div class="eyebrow">{{ section.settings.eyebrow | escape | replace: 'eJuno', '<span class="ejuno-brand-word">eJuno</span>' }}</div>
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.lead != blank -%}
          <p>{{ section.settings.lead }}</p>
        {%- endif -%}
      </div>
    </div>
    <div class="ej-cols">
      <div class="ej-cols__item"><div class="ej-cols__media">{%- if section.settings.point_image_1 != blank -%}{{ section.settings.point_image_1 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', sizes: '(min-width: 750px) 33vw, 100vw', alt: '' }}{%- else -%}<img src="{{ section.settings.point_fallback_1 | default: 'ejuno-photo-12.jpg' | asset_url }}" alt="" loading="lazy" width="900" height="600">{%- endif -%}</div><span class="ej-cols__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.6"/><path d="m20 20-4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span><h3>Be Discovered in Context</h3><p>Appear alongside venues, inspiration and planning journeys, not in isolation.</p></div>
      <div class="ej-cols__item"><div class="ej-cols__media">{%- if section.settings.point_image_2 != blank -%}{{ section.settings.point_image_2 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', sizes: '(min-width: 750px) 33vw, 100vw', alt: '' }}{%- else -%}<img src="{{ section.settings.point_fallback_2 | default: 'ejuno-photo-05.jpg' | asset_url }}" alt="" loading="lazy" width="900" height="600">{%- endif -%}</div><span class="ej-cols__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3.5" y="5" width="17" height="14" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="m4 16 4.5-4.5 4 4 2.5-2.5 5 5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></span><h3>Show the Quality of Your Work</h3><p>Use a richer visual presentation to communicate fit and style.</p></div>
      <div class="ej-cols__item"><div class="ej-cols__media">{%- if section.settings.point_image_3 != blank -%}{{ section.settings.point_image_3 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', sizes: '(min-width: 750px) 33vw, 100vw', alt: '' }}{%- else -%}<img src="{{ section.settings.point_fallback_3 | default: 'ejuno-photo-15.jpg' | asset_url }}" alt="" loading="lazy" width="900" height="600">{%- endif -%}</div><span class="ej-cols__icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M5 18.5V7a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H8.5L5 18.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></span><h3>Build Better Enquiries</h3><p>Give couples enough context to understand what you offer before they contact you.</p></div>
    </div>
  </div>
</section>

{%- comment -%} Card 723: photo above each "Why eJuno" point (editable in section settings). {%- endcomment -%}
<style>
  .partner-benefits .ej-cols__media{aspect-ratio:3/2;overflow:hidden;border-radius:14px;margin:0 0 18px;background:#ece5dd}
  .partner-benefits .ej-cols__media img{width:100%;height:100%;object-fit:cover;display:block}
</style>

{% schema %}
{
  "name": "partner 2",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {"type":"image_picker","id":"point_image_1","label":"Point 1 image"},
    {"type":"text","id":"point_fallback_1","label":"Point 1 fallback asset","default":"ejuno-photo-12.jpg"},
    {"type":"image_picker","id":"point_image_2","label":"Point 2 image"},
    {"type":"text","id":"point_fallback_2","label":"Point 2 fallback asset","default":"ejuno-photo-05.jpg"},
    {"type":"image_picker","id":"point_image_3","label":"Point 3 image"},
    {"type":"text","id":"point_fallback_3","label":"Point 3 fallback asset","default":"ejuno-photo-15.jpg"},
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why eJuno"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A marketplace built for destination weddings"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Partner with a curated platform where your work is shown in context, not lost in a generic directory."
    }
  ],
  "presets": [
    {
      "name": "partner 2"
    }
  ]
}
{% endschema %}
