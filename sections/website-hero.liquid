<section class="product-head"><div class="container"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1 class="h1">{{ section.settings.heading }}</h1><p class="lead">{{ section.settings.text }}</p></div></section>

{% schema %}
{
  "name": "Website hero",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Wedding website"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Wedding Website, Beautifully Done"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Share your story, the schedule and travel tips with guests, and collect RSVPs in one place."
    }
  ],
  "presets": [
    {
      "name": "Website hero"
    }
  ]
}
{% endschema %}
