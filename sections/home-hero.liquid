        hhClose(false); closeHeroDropdowns();
        hhOpen = d; list.hidden = false; btn.setAttribute('aria-expanded', 'true');
        setActive(Math.max(sel.selectedIndex, 0));
      }
      function choose(i) {
        if (sel.selectedIndex !== i) { sel.selectedIndex = i; sel.dispatchEvent(new Event('change', { bubbles: true })); }
        sync(); hhClose(true);
      }
      btn.addEventListener('click', function (e) { e.preventDefault(); if (hhOpen === d) hhClose(false); else open(); });
      list.addEventListener('mousedown', function (e) { e.preventDefault(); });
      list.addEventListener('click', function (e) {
        e.preventDefault(); e.stopPropagation();
        var li = e.target.closest('.hh-dd__opt'); if (li) choose(opts.indexOf(li));
      });
      list.addEventListener('mousemove', function (e) { var li = e.target.closest('.hh-dd__opt'); if (li) setActive(opts.indexOf(li)); });
      btn.addEventListener('keydown', function (e) {
        var k = e.key, isOpen = hhOpen === d;
        if (k === 'ArrowDown' || k === 'ArrowUp') { e.preventDefault(); if (!isOpen) open(); else setActive(d.active + (k === 'ArrowDown' ? 1 : -1)); }
        else if (k === 'Home' || k === 'End') { if (isOpen) { e.preventDefault(); setActive(k === 'Home' ? 0 : opts.length - 1); } }
        else if (k === 'Enter' || k === ' ') { e.preventDefault(); if (isOpen) choose(d.active); else open(); }
        else if (k === 'Escape') { if (isOpen) { e.preventDefault(); hhClose(true); } }
        else if (k === 'Tab') { hhClose(false); }
      });
      sel.addEventListener('change', sync);
      sync();
    }
    function initHeroDropdowns(root) {
      root.querySelectorAll('[data-home-hero-filters] select').forEach(enhanceSelect);
      if (window.__hhDdGlobal) return;
      window.__hhDdGlobal = true;
      var close = function () { hhClose(false); };
      document.addEventListener('pointerdown', function (e) { if (hhOpen && !hhOpen.btn.parentNode.contains(e.target)) close(); }, true);
      document.addEventListener('focusin', function (e) { if (hhOpen && !hhOpen.btn.parentNode.contains(e.target)) close(); });
      // Header / nav / mega menu / drawers / cookie banner: close as soon as the pointer or focus gets there.
      var overlaySel = 'header, .header, [class*="header"], nav, [class*="mega"], [class*="menu"], [class*="drawer"], [role="dialog"], details[open], [class*="cookie"], #shopify-pc__banner';
      function inOverlay(t) { return t && t.closest && !t.closest('.home-hero-live') && t.closest(overlaySel); }
      ['pointerover', 'mouseover', 'focusin', 'touchstart'].forEach(function (ev) {
        document.addEventListener(ev, function (e) { if (inOverlay(e.target)) { close(); closeHeroDropdowns(); } }, { capture: true, passive: true });
      });
      document.addEventListener('toggle', function (e) { if (e.target.open) { close(); closeHeroDropdowns(); } }, true);
      if (window.MutationObserver) {
        new MutationObserver(function (muts) {
          if (!hhOpen) return;
