      document.addEventListener('visibilitychange', function () { if (document.hidden) close(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
      window.addEventListener('scroll', function () {
        if (!hhOpen) return;
        var r = hhOpen.btn.getBoundingClientRect();
        if (r.bottom < 0 || r.top > window.innerHeight) close();
      }, { passive: true });
    }

    function boot() {
      document.querySelectorAll('.home-hero-live').forEach(initHomeHeroSearch);
      document.querySelectorAll('.home-hero-live').forEach(initHomeHeroFilters);
      initHeroDropdownClose();
      document.querySelectorAll('.home-hero-live').forEach(initHeroDropdowns);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
    document.addEventListener('shopify:section:load', boot);
  })();
</script>

{% schema %}
{
  "name": "Home hero",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Upload a master at least 3500px wide (ideally 4000px+) so the hero stays sharp on Mac Retina, iPhone, and large displays."
    },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile hero image", "info": "Optional portrait crop for phones. Falls back to a theme crop of the main photo." },
    { "type": "text", "id": "image_alt", "label": "Image alt", "default": "Couple entering their wedding through open floral doors" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Step inside" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Enter the Wedding You Imagined" },
    { "type": "textarea", "id": "text", "label": "Supporting text", "default": "Discover extraordinary venues and trusted wedding professionals across Italy." },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search venues or vendors" },
    { "type": "text", "id": "search_button_label", "label": "Search button label", "default": "Search" },
    { "type": "header", "content": "Venue filters" },
    { "type": "checkbox", "id": "show_filters", "label": "Show venue filters", "default": true },
    { "type": "collection", "id": "venues_collection", "label": "Venues collection", "info": "Blank uses the collection with handle 'venues'." },
    { "type": "textarea", "id": "filter_locations", "label": "Locations (one per line)", "info": "Matched against venue names and tags on the results page.", "default": "Italian Lakes\nTuscany\nAmalfi Coast\nPuglia\nSicily" },
    { "type": "textarea", "id": "filter_guests", "label": "Guest options (label|product tag)", "info": "One per line. The tag must match the venue product tag.", "default": "Under 20|<20 guests\n21–50|21-50 guests\n51–100|51-100 guests\n101–150|101-150 guests\n151–200|151-200 guests\n201–250|201-250 guests" },
    { "type": "text", "id": "filter_budgets", "label": "Budget caps (comma-separated)", "info": "Whole amounts in store currency. Uses the price filter.", "default": "30000,60000,100000,150000,200000" },
    { "type": "text", "id": "filters_button_label", "label": "Filters button label", "default": "Find venues" },
    { "type": "checkbox", "id": "location_use_filter", "label": "Location uses the venue location filter", "info": "Turn on once custom.location is filled on venues and enabled in Search & Discovery. Off = keyword search.", "default": false },
    { "type": "checkbox", "id": "show_region_chips", "label": "Show quick region buttons", "default": true },
    { "type": "text", "id": "chips_label", "label": "Region buttons label (screen readers)", "default": "Popular regions" }
  ],
  "presets": [{ "name": "Home hero" }]
}
