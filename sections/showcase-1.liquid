<section class="b2b-hero"><img src="{% if section.settings.image_1 != blank %}{{ section.settings.image_1 | image_url: width: 2000 }}{% else %}{{ section.settings.fallback_1 | asset_url }}{% endif %}" width="1672" height="941" loading="lazy"><div class="b2b-copy"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1 class="h1">{{ section.settings.heading }}</h1><p>Showcase the craft, style and experience behind your business in a way that helps the right couples understand why you are different.</p><a href="#showcaseWorkForm" class="btn primary">Submit your work</a></div></section>

{% schema %}
{
  "name": "showcase 1",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1 (SHW-IMG-001.webp)"
    },
    {
      "type": "text",
      "id": "fallback_1",
      "label": "Fallback asset 1",
      "default": "SHW-IMG-001.webp"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "For wedding professionals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get Your Work Featured on eJuno"
    }
  ],
  "presets": [
    {
      "name": "showcase 1"
    }
  ]
}
{% endschema %}
