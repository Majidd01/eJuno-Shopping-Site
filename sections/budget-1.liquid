<section class="product-head"><div class="container"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1 class="h1">{{ section.settings.heading }}</h1><p class="lead">{{ section.settings.lead }}</p></div></section>

{% schema %}
{
  "name": "budget 1",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Budget"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Wedding Budget, at a Glance"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead",
      "default": "Set your budget, split it across categories and see at a glance where your money is going."
    }
  ],
  "presets": [
    {
      "name": "budget 1"
    }
  ]
}
{% endschema %}
