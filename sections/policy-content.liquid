<section class="section tight ejuno-policy-content">
  <div class="container">
    {% if section.settings.heading != blank %}
      <h2 class="h2 ejuno-policy-content__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="ejuno-policy-content__body article-body">
      {{ section.settings.content }}
    </div>
  </div>
</section>

{% stylesheet %}
.ejuno-policy-content {
  padding-top: 12px;
  padding-bottom: 72px;
}

.ejuno-policy-content__heading {
  margin: 0 0 28px;
}

.ejuno-policy-content__body {
  max-width: 820px;
  margin: 0;
  font-family: var(--sans);
  font-size: 16px;
  line-height: 1.7;
  color: #3f3833;
}

.ejuno-policy-content__body :first-child {
  margin-top: 0;
}

.ejuno-policy-content__body h2,
.ejuno-policy-content__body h3,
.ejuno-policy-content__body h4 {
  font-family: var(--serif);
  font-weight: 400;
  color: var(--ink);
  margin: 36px 0 12px;
}

.ejuno-policy-content__body h2 {
  font-size: 32px;
}

.ejuno-policy-content__body h3 {
  font-size: 24px;
}

.ejuno-policy-content__body p,
.ejuno-policy-content__body li {
  color: #3f3833;
}

.ejuno-policy-content__body ul,
.ejuno-policy-content__body ol {
  padding-left: 1.25em;
  margin: 12px 0 20px;
}

.ejuno-policy-content__body a {
  color: var(--berry);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.ejuno-policy-content__body strong {
  color: var(--ink);
}

@media (max-width: 760px) {
  .ejuno-policy-content {
    padding-bottom: 48px;
    padding-top: 8px;
  }

  .ejuno-policy-content__heading {
    margin-bottom: 20px;
    font-size: clamp(26px, 6.5vw, 34px);
  }

  .ejuno-policy-content__body {
    font-size: 15px;
    line-height: 1.65;
  }

  .ejuno-policy-content__body h2 {
    font-size: 24px;
    margin-top: 28px;
  }

  .ejuno-policy-content__body h3 {
    font-size: 20px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Policy content",
  "tag": "div",
  "class": "ejuno-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Optional heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Policy content",
      "default": "<p>Add your policy content here.</p>"
    }
  ],
  "presets": [{ "name": "Policy content" }]
}
{% endschema %}
